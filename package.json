{
  "name": "suivi-dossiers-migration",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace client\" \"npm:dev --workspace server\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm test --workspace server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "tsx server/scripts/sql.ts schema",
    "db:migrate:dossier-detail": "tsx server/scripts/sql.ts dossier-detail",
    "db:migrate:notifications": "tsx server/scripts/sql.ts notifications",
    "db:migrate:reference-rules": "tsx server/scripts/sql.ts reference-rules",
    "db:migrate:dossier-compliance": "tsx server/scripts/sql.ts dossier-compliance",
    "db:migrate:dossier-launch-specification": "tsx server/scripts/sql.ts dossier-launch-specification",
    "db:migrate:dossier-provisional-bond-return": "tsx server/scripts/sql.ts dossier-provisional-bond-return",
    "db:migrate:surveillance-events": "tsx server/scripts/sql.ts surveillance-events",
    "db:migrate:leave-management": "tsx server/scripts/sql.ts leave-management",
    "db:migrate:user-service": "tsx server/scripts/sql.ts user-service",
    "db:migrate:auth-session-hardening": "tsx server/scripts/sql.ts auth-session-hardening",
    "seed": "tsx server/scripts/sql.ts seed",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  }
}
