buildOption feature-push-notifications (
    name: Feature: Push Notifications
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_PUSH_NOTIFICATIONS
    }
    comments {
        comments: Allow users to subscribe to push notifications on their devices.
    }
)

buildOption feature-user-settings (
    name: Feature: User Settings1
    status {
        status: include
        onUpgradeKeepStatus: true
    }
    advanced {
        featureIdentifier: APPLICATION_USER_SETTINGS
    }
    comments {
        comments: The user settings page is a drawer that links to all user settings pages.
    }
)

buildOption fonctionnalité-a-propos-de-la-page (
    name: Fonctionnalité: A propos de la page
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_ABOUT_PAGE
    }
    comments {
        comments: A propos de cette page d'application.
    }
)

buildOption fonctionnalité-contrôle-d-accès (
    name: Fonctionnalité: Contrôle d'accès
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_ACCESS_CONTROL
    }
    comments {
        comments: Incorporez l'authentification utilisateur basée sur les rôles dans votre application et gérez les mappings de nom utilisateur avec les rôles d'application.
    }
)

buildOption fonctionnalité-génération-d-états-d-activité (
    name: Fonctionnalité: Génération d'états d'activité
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_ACTIVITY_REPORTING
    }
    comments {
        comments: Incluez de nombreux états et graphiques relatifs à l'activité des utilisateurs finals.
    }
)

buildOption fonctionnalité-informations-en-retour (
    name: Fonctionnalité: Informations en retour
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_FEEDBACK
    }
    comments {
        comments: Indiquez un mécanisme permettant aux utilisateurs finals de publier des commentaires généraux à l'intention des administrateurs et des développeurs de l'application.
    }
)

buildOption fonctionnalité-options-de-configuration (
    name: Fonctionnalité: Options de configuration
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_CONFIGURATION
    }
    comments {
        comments: Autorisez les administrateurs de l'application à activer ou à désactiver une fonctionnalité spécifique associée à une option de construction Oracle APEX à partir de l'application.
    }
)

buildOption fonctionnalité-sélection-du-style-de-thème (
    name: Fonctionnalité: Sélection du style de thème
    status {
        status: include
    }
    advanced {
        featureIdentifier: APPLICATION_THEME_STYLE_SELECTION
    }
    comments {
        comments: "Autorisez les administrateurs à sélectionner un schéma de couleur par défaut (style de thème) pour l'application. Les administrateurs ont également la possibilité d'autoriser les utilisateurs à choisir leur propre style de thème. "
    }
)

buildOption mis-en-commentaire (
    name: Mis en commentaire
)

