list ajout-commande (
    name: Ajout Commande

    entry الرجاء-تحديد-أرقام-العقود-و-الشركات (
        label: الرجاء تحديد أرقام العقود و الشركات
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 35
            }
        }
    )

    entry الرجاء-تحديد-عدد-الطلبيات-x2f-العقود (
        label: الرجاء تحديد عدد الطلبيات &#x2F; العقود
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 34
            }
        }
    )

    entry خاصيات-العقد (
        label: خاصيات العقد
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 36
            }
        }
    )

)

list barre-de-navigation (
    name: Barre de navigation

    entry a-propos-de (
        label: A propos de
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 30
        }
        userDefinedAttributes {
            2: icon-only
        }
        config {
            buildOption: @fonctionnalité-a-propos-de-la-page
        }
    )

    entry a-propos-de-la-page (
        label: A propos de la page
        icon {
            imageIconCssClasses: fa-info-circle-o
        }
        layout {
            sequence: 60
            parentEntry: @a-propos-de
        }
        link {
            target: {
                page: 10060
                clearCache: 10060
            }
        }
        config {
            buildOption: @fonctionnalité-a-propos-de-la-page
        }
    )

    entry aide-de-la-page (
        label: Aide de la page
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 40
            parentEntry: @a-propos-de
        }
        link {
            target: {
                page: 10061
                items: {
                    P10061_PAGE_ID: &APP_PAGE_ID.
                }
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        config {
            buildOption: @fonctionnalité-a-propos-de-la-page
        }
    )

    entry fermer-la-session (
        label: Fermer la session
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 90
            parentEntry: @p0-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

    entry informations-en-retour (
        label: Informations en retour
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10050
                items: {
                    P10050_PAGE_ID: &APP_PAGE_ID.
                }
                clearCache: 10050
                action: resetPagination
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_util.feedback_enabled
        }
        config {
            buildOption: @fonctionnalité-informations-en-retour
        }
    )

    entry installer-l-application (
        label: Installer l'application
        icon {
            imageIconCssClasses: fa-cloud-download
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #action$a-pwa-install
            }
        }
        userDefinedAttributes {
            2: a-pwaInstall
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 50
            parentEntry: @a-propos-de
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry list_item-2 (
        label: ---
        layout {
            sequence: 80
            parentEntry: @p0-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry p0-user (
        label: &P0_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

)

list configuration-de-l-application (
    name: Configuration de l'application
    config {
        buildOption: @fonctionnalité-options-de-configuration
    }

    entry options-de-configuration (
        label: Options de configuration
        icon {
            imageIconCssClasses: fa-sliders
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10010
                clearCache: 10010
            }
        }
        userDefinedAttributes {
            1: Activer ou désactiver des fonctionnalités de l'application
        }
        config {
            buildOption: @fonctionnalité-options-de-configuration
        }
    )

)

list contrôle-d-accès (
