            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10040
            }
        }
        userDefinedAttributes {
            1: Modifier les paramètres de contrôle d'accès et désactiver le contrôle d'accès
        }
    )

    entry utilisateurs (
        label: Utilisateurs
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10041
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Définir le niveau d'accès des utilisateurs authentifiés de cette application
        }
    )

)

list etats-d-activité (
    name: Etats d'activité
    config {
        buildOption: @fonctionnalité-génération-d-états-d-activité
    }

    entry journal-des-automatisations (
        label: Journal des automatisations
        icon {
            imageIconCssClasses: fa-gears
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 10035
                clearCache: 10035
                action: resetRegions
            }
        }
        userDefinedAttributes {
            1: Etat des messages et des exécutions d'automatisation consignés par cette application
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from apex_appl_automations a, apex_automation_log l
                where a.automation_id = l.automation_id
                and l.application_id = :APP_ID
                ```
        }
    )

    entry journal-des-erreurs-de-l-application (
        label: Journal des erreurs de l'application
        icon {
            imageIconCssClasses: fa-exclamation
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 10032
                clearCache: 10032
            }
        }
        userDefinedAttributes {
            1: Etat des erreurs consignées par cette application
        }
    )

    entry performances-de-page (
        label: Performances de page
        icon {
            imageIconCssClasses: fa-file-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 10033
                clearCache: 10033
            }
        }
        userDefinedAttributes {
            1: Etat de l'activité et des performances par page d'application
        }
    )

    entry principaux-utilisateurs (
        label: Principaux utilisateurs
        icon {
            imageIconCssClasses: fa-user-chart
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10031
                clearCache: 10031
            }
        }
        userDefinedAttributes {
            1: Etat des vues de page consolidées par utilisateur
        }
    )

    entry tableau-de-bord (
        label: Tableau de bord
        icon {
            imageIconCssClasses: fa-area-chart
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10030
                clearCache: 10030
            }
        }
        userDefinedAttributes {
            1: Consulter les mesures d'activité d'application
        }
    )

    entry vues-de-page (
        label: Vues de page
        icon {
            imageIconCssClasses: fa-file-search
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 10034
                clearCache: 10034
                action: resetRegions
            }
        }
        userDefinedAttributes {
            1: Etat de chaque vue de page par utilisateur comportant la date d'accès et le temps écoulé
        }
    )

)

