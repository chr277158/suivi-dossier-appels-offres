lov access-roles (
    name: ACCESS_ROLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select role_name d, role_id r
            from APEX_APPL_ACL_ROLES where application_id = :APP_ID 
            order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov cc-ref-ao (
    name: CC.REF_AO
    source {
        tableName: CC
    }
    columnMapping {
        return: REF_AO
        defaultSort: REF_AO
    }
)

lov desktop-theme-styles (
    name: DESKTOP THEME STYLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select s.name d,
                   s.theme_style_id r
              from apex_application_theme_styles s,
                   apex_application_themes t
             where s.application_id = :app_id
               and t.application_id = s.application_id
               and t.theme_number   = s.theme_number
               and t.ui_type_name   = 'DESKTOP'
               and t.is_current     = 'Yes'
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov email-username-format (
    name: EMAIL_USERNAME_FORMAT
    source {
        location: staticValues
    }

    entry email (
        sequence: 1
        display: Adresses électroniques
        return: EMAIL
    )

)

lov feedback-rating (
    name: FEEDBACK_RATING
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: Positif
        return: 3
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-smile-o fa-2x feedback-positive" aria-hidden="true" ></span></span>
        }
    )

    entry lov_data-2 (
        sequence: 2
        display: Neutre
        return: 2
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-emoji-neutral fa-2x feedback-neutral" aria-hidden="true" ></span></span>
        }
    )

    entry lov_data-3 (
        sequence: 3
        display: Négatif
        return: 1
        globalization {
            template: <span title="#DISPLAY_VALUE#" aria-label="#DISPLAY_VALUE#"><span class="fa fa-frown-o fa-2x feedback-negative" aria-hidden="true" ></span></span>
        }
    )

)

lov feedback-status (
    name: FEEDBACK_STATUS
    source {
        location: staticValues
    }

    entry lov_data (
        sequence: 1
        display: Aucune action
        return: 0
    )

    entry lov_data-2 (
        sequence: 2
        display: Réception confirmée
        return: 1
    )

    entry lov_data-3 (
        sequence: 3
        display: Ouvert
        return: 3
    )

    entry lov_data-4 (
        sequence: 4
        display: Fermé
        return: 4
    )

)

lov liste-monnait (
    name: LISTE MONNAIT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 'Dollar US' as display_val, 'USD' as return_val, 'fa-dollar-sign' as icon_val FROM dual
            UNION ALL
            SELECT 'Euro' as display_val, 'EUR' as return_val, 'fa-euro-sign' as icon_val FROM dual
            UNION ALL
            SELECT 'Dinar Tunisien' as display_val, 'TND' as return_val, 'fa-money-bill-alt' as icon_val FROM dual
            UNION ALL
            SELECT 'Autre' as display_val, 'OTHER' as return_val, 'fa-question-circle' as icon_val FROM dual
            ```
    }
    columnMapping {
        return: RETURN_VAL
        display: DISPLAY_VAL
        defaultSort: RETURN_VAL
        icon: ICON_VAL
    }
)

lov timeframe-4-weeks (
    name: TIMEFRAME (4 WEEKS)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select disp,
                   val as seconds
              from table( apex_util.get_timeframe_lov_data )
             order by insert_order
            ```
    }
    columnMapping {
        return: SECONDS
        display: DISP
    }
)

lov user-theme-preference (
    name: USER_THEME_PREFERENCE
    source {
        location: staticValues
    }

    entry yes (
        sequence: 1
        display: Autoriser les utilisateurs finals à choisir le style de thème
        return: Yes
    )

)

lov view-as-report-chart (
    name: VIEW_AS_REPORT_CHART
    source {
        location: staticValues
    }

    entry chart (
        sequence: 2
        display: Ajouter une page de graphique
        return: CHART
        globalization {
            template: <span class="fa fa-pie-chart" aria-hidden="true"></span><span class="u-VisuallyHidden">#DISPLAY_VALUE#</span>
        }
    )

    entry report (
        sequence: 1
        display: Ajouter une page d'état
        return: REPORT
        globalization {
            template: <span class="fa fa-table" aria-hidden="true"></span><span class="u-VisuallyHidden">#DISPLAY_VALUE#</span>
        }
    )

)

