appProcess get-pending-reminders (
    name: GET_PENDING_REMINDERS
    type: executeCode
    source {
        plsqlCode:
            ```plsql
            DECLARE
                l_cursor SYS_REFCURSOR;
            BEGIN
                -- جلب التنبيهات التي تم تحديثها بواسطة الـ Job الخلفي في الدقيقة الأخيرة
                OPEN l_cursor FOR
                    SELECT 
                        NOTE_TITLE, 
                        NOTE_DETAILS, 
                        IMPORTANCE_LEVEL
                    FROM USER_NOTES
                    WHERE USER_ID = :APP_USER
                      AND IS_SENT = 'Y'
                      AND LAST_UPDATED >= SYSDATE - (1/1440) -- تم تحديثها في الدقيقة الأخيرة بواسطة الـ Job
                      AND REMINDER_DATETIME <= SYSDATE + (1/1440); -- للتأكد من أنها لا تزال ضمن نطاق التنبيه
            
                APEX_JSON.WRITE(l_cursor);
            END;
            ```
    }
    execution {
        sequence: 2
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

