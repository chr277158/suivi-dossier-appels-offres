page 21 (
    name: متابعة تقدم الملفات
    alias: مراحل-التقدم
    title: متابعة تقدم الملفات
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* 1) Donne une hauteur plus grande à la zone header (optionnel) */
            .myClass .a-GV-header{
              height: 60px;         /* Ajuste selon ton besoin */
              line-height: 50px;     /* Optionnel: vertical align/centrage */
              padding: 5px;
              white-space: normal;   /* Autorise le retour à la ligne */
              overflow-wrap: break-word;
              word-wrap: break-word;
            }
            
            /* 2) Force le texte du libellé à se wrapper */
            .myClass .a-GV-header .a-GV-headerLabel{
              white-space: normal;
              overflow-wrap: break-word;
              word-wrap: break-word;
              height: auto;
              line-height: 1.2;      /* Plus naturel pour du multi-ligne */
              padding: 5px;
            }
            .a-GV-header{ 
                pointer-events: none;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region مراحل-التقدم (
        name: مراحل التقدم
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select CC.ID as ID,
                    CC.REF_AO as REF_AO,
                    CC.OBJET_CCT as OBJET_CCT,
                    CC.BUDGET as BUDGET,
                    SP."طريقة_ابرام_الصفقة" as "طريقة_ابرام_الصفقة",
                    SP."نوعية_الطلب" as "نوعية_الطلب",
                    SP."اللجنة_المختصة" as "اللجنة_المختصة",
                    CC.NATURE_DE_DEPENSE as NATURE_DE_DEPENSE,
                    CC."DÉTAIL_DE_RÉPONSE" as "DÉTAIL_DE_RÉPONSE",
                    CC."DATE_CRÉATION" as "DATE_CRÉATION",
                    SP."تاريخ_تقديم_كراسات_الشروط_للمصادقة" as "تاريخ_تقديم_كراسات_الشروط_للمصادقة",
                    SP."تاريخ_مصادقة_اللجنة_على_كراسات_الشروط" as "تاريخ_مصادقة_اللجنة_على_كراسات_الشروط",
                    SP."التاريخ__للإعلان_عن_المنافسة" as "التاريخ__للإعلان_عن_المنافسة",
                    CC."DATE_LIMITE_PROPOSÉE" as "DATE_LIMITE_PROPOSÉE",
                    CC.DATE_OUVERTURE_DES_PLIS as DATE_OUVERTURE_DES_PLIS,
                    SP."تاريخ_قرار__لجنة_الصفقات" as "تاريخ_قرار__لجنة_الصفقات",
                    CC.STATUS as STATUS,
                    SP."تاريخ_ارجاع_الضمانات_الوقتية" as "تاريخ_ارجاع_الضمانات_الوقتية",
                    SP."المكلف_بالملف" as "المكلف_بالملف",
                     case when SP."اللجنة_المختصة" = 'CRA' then 40 else 4 end as P,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID_1' else 'P4_ID_1' end as VID1,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID_2' else 'P4_ID_2' end as VID2,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID' else 'P4_ID' end as VID,
                    fl.ID as FL_ID,
                    fl.ID_CC 
                 from FICHIER_LNCEMENT fl,
                    SP SP,
                    CC CC 
                 where (CC.ID=SP.ID
                    and CC.ID=fl.ID_CC)
                 and 
                 
                 
                
                 
                    -- Condition 2 : Sinon, on filtre sur le champ
                    "المكلف_بالملف" = v('P0_USER')
                
                AND  CC.STATUS <'5'
                
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: myClass
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        editAuthorization {
            update: @droits-de-lecteur
            delete: @droits-de-contribution
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            fixedRowHeight: false
        }
        messages {
            whenNoDataFound: لا توجد معطيات حاليا
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
            savePublicReportAuthorization: @droits-d-administration
        }
        download {
            authorization: @droits-de-lecteur
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 19929800525120332
        }

