                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                
                    -- نص الشريط: الدقائق + النسبة المئوية
                    CASE
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE
                             AND REMINDER_DATETIME >= SYSDATE - 0.1/24 THEN
                             '🔄 تذكير مستمر (' || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             ) || '%)'
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE THEN
                             '✅ انتهى (100%)'
                        ELSE
                             FLOOR(((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440)
                             || ' Minutes ('
                             || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
