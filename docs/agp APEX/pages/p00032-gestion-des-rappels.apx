page 32 (
    name: Gestion des Rappels
    alias: GESTION-DES-RAPPELS
    title: Gestion des Rappels
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // 1. طلب الإذن لتنبيهات الـ Windows
            function requestNotificationPermission() {
                if ('Notification' in window &&
                    Notification.permission !== 'granted' &&
                    Notification.permission !== 'denied') {
                    Notification.requestPermission();
                }
            }
            
            // 2. تنبيهات مستمرة حتى انتهاء الموعد (تعمل عند النداء)
            function checkAndDisplayReminders() {
                apex.server.process('GET_PENDING_REMINDERS', {
                    x01: 'Check'
                }, {
                    dataType: "json",
                    success: function (pData) {
                        if (pData && pData.items && pData.items.length > 0) {
                            pData.items.forEach(function (item) {
                                var title = item.NOTE_TITLE;
                                var details = item.NOTE_DETAILS;
                                var importance = item.IMPORTANCE_LEVEL;
            
                                if (importance == 3) {
                                    // 🔴 مهم جداً: Native Notification
                                    if (Notification.permission === "granted") {
                                        new Notification("🚨 تذكير مستمر: " + title, {
                                            body: details + "\n(سيستمر حتى الموعد النهائي)",
                                            icon: "data:image/svg+xml;utf8,",
                                            badge: "data:image/svg+xml;utf8,"
                                        });
                                    }
                                } else if (importance == 2) {
                                    // 🟠 مهم: Popup
                                    apex.message.showPageSuccess("🔔 تذكير مستمر: " + title + "<br>" + details);
                                } else if (importance == 1) {
                                    // 🔵 عادي: إشعار خفيف
                                    apex.message.clearErrors();
                                    apex.message.showPageSuccess("📝 " + title);
                                }
                            });
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error("خطأ في جلب التنبيهات:", textStatus);
                    }
                });
            }
            
            // 3. تطبيق النسبة المئوية على شريط التقدم داخل الـ Badge
            function applyProgressWidth() {
                document.querySelectorAll('#reminders_cards .a-CardView-badge').forEach(function (badge) {
                    var text = badge.innerText || badge.textContent;
                    // مثال نص: "15 دقيقة (40%)" أو "🔄 تذكير مستمر (70%)"
                    var match = text.match(/\((\d+)%\)/);
                    if (match && match[1]) {
                        var percent = match[1];
                        badge.style.setProperty('--progress-width', percent + '%');
                    }
                });
            }
            
            // 4. تحديث كروت التذكير + الشريط
            function refreshRemindersCards() {
                try {
                    var reg = apex.region('reminders_cards');
                    if (reg) {
                        reg.refresh();
                        // بعد أن ينتهي الـ refresh نطبّق النسبة على البادجات
                        setTimeout(applyProgressWidth, 500);
                    }
                } catch (e) {
                    console.error('Refresh error:', e);
                }
            }
            
            // 5. تشغيل كل شيء عند تحميل الصفحة
            requestNotificationPermission();
            checkAndDisplayReminders();   // فحص فوري أول مرة
            refreshRemindersCards();      // تحديث الكروت أول مرة
            
            // تنبيهات + تحديث كروت كل 30 ثانية
            setInterval(function () {
                checkAndDisplayReminders();
                refreshRemindersCards();
            }, 30000); // 30000 ms = 30 ثانية
            
            ```
    }
    css {
        inline:
            ```css
            .a-CardView-badge {
                background: linear-gradient(90deg, #f7fafc, #edf2f7) !important;
                border-radius: 20px !important;
                padding: 6px 12px !important;
                border: 2px solid #e2e8f0 !important;
                margin-top: 12px !important;
                font-weight: 600 !important;
                font-size: 0.9rem !important;
                position: relative !important;
                overflow: hidden !important;
            }
            
            .a-CardView-badge::before {
                content: '';
                position: absolute;
                top: 0; left: 0; bottom: 0;
                width: calc(var(--progress-width, 0%) - 8px);
                /* لون أخضر شفاف بدل تدرّج قوي */
                background: rgba(72, 187, 120, 0.25);  /* 0.25 = شفافية 25% */
                border-radius: 16px;
                transition: width 1s ease;
                z-index: 1;
            }
            .u-color-9 .a-CardView-badge::before  { background: rgba(245, 101, 101, 0.25); }  /* أحمر شفاف */
            .u-color-37 .a-CardView-badge::before { background: rgba(250, 191, 137, 0.25); }  /* برتقالي شفاف */
            .u-color-1 .a-CardView-badge::before  { background: rgba(99, 179, 237, 0.25); }   /* أزرق شفاف */
            
            
            /* ألوان الأهمية */
            .u-color-9 .a-CardView-badge::before  { background: linear-gradient(90deg, #f56565, #e53e3e); }
            .u-color-37 .a-CardView-badge::before { background: linear-gradient(90deg, #fabf89, #dd6b20); }
            .u-color-1 .a-CardView-badge::before  { background: linear-gradient(90deg, #63b3ed, #3182ce); }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region n (
        name: " n"
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        accessibility {
            useLandmark: false
        }
        advanced {
            htmlDomId: reminders_cards
        }
    )

    region notes (
        name: Notes
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    ID,
                    NOTE_TITLE   AS NOTETITLE,
                    NOTE_DETAILS AS NOTEDETAILS,
                    REMINDER_DATETIME,
                    TO_CHAR(REMINDER_DATETIME, 'DD Mon - HH24:MI') AS REMINDERFMT,
                
                    -- أيقونة ولون حسب الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'fa-bell text-danger'
                        WHEN 2 THEN 'fa-exclamation-triangle text-warning'
                        WHEN 1 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                
                    -- نص الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN '🔴 عاجل جداً'
                        WHEN 2 THEN '🟠 مهم'
                        WHEN 1 THEN '🔵 عادي'
                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                
                    -- نص الشريط: الدقائق + النسبة المئوية
                    CASE
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE
                             AND REMINDER_DATETIME >= SYSDATE - 0.1/24 THEN
                             '🔄 تذكير مستمر (' || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             ) || '%)'
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE THEN
                             '✅ انتهى (100%)'
                        ELSE
                             FLOOR(((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440)
                             || ' Minutes ('
                             || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             )
                             || '%) '
                    END AS MINUTES_LEFT,
                
                    -- نسبة التقدم (0-100) متاحة لو احتجتها لاحقاً
                    LEAST(100, GREATEST(0,
                        (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                              ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                    )) AS PROGRESS_PERCENT,
                
                    -- كلاس إضافي لو أردت تأثير خاص عند الاقتراب (اختياري)
                    CASE
                        WHEN ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440 <= 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                
                    -- لون شريط التقدم حسب الأهمية (لو استخدمته داخل CSS)
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'bg-danger'
                        WHEN 2 THEN 'bg-warning'
                        WHEN 1 THEN 'bg-info'
                        ELSE 'bg-secondary'
                    END AS PROGRESS_COLOR
                
                FROM USER_NOTES
                WHERE USER_ID = :P32_ROLE
                   AND NOT (IS_SENT = 'Y'
                           AND REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) < SYSDATE -1)
                ORDER BY IMPORTANCE_LEVEL DESC, REMINDER_DATETIME ASC;
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @rappel
            slot: subRegions
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleB
                t-Form--stretchInputs
                t-Form--leftLabels
            ]
            cssClasses: BADGE_CLASS
        }
        advanced {
            htmlDomId: reminders_cards
            customAttributes: Refresh Interval: 600
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: NOTETITLE
        }
        subtitle {
            column: IMPORTANCETEXT
        }
        body {
            column: NOTEDETAILS
        }
        secondaryBody {
            column: REMINDERFMT
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: CARDICON
            iconCssClasses: CARDCOLORCLASS
            badgeColumn: MINUTES_LEFT
            badgeLabel: "&MINUTES_LEFT. "
        }

        action action (
            label: تعديل
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 33
                    items: {
                        P33_ID_1: &ID.
                    }
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-edit
            }
        )

        action action-2 (
            label: تعديل
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 33
                    items: {
                        P33_ID_1: &ID.
                    }
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-edit
            }
        )

    )

    region notes-2 (
        name: Notes2
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    cc.id,
                    cc.ref_ao,
                    cc.objet_cct,
                    cc.budget,
                    cc."DÉTAIL_DE_RÉPONSE",
                    cc.nature_de_depense,
                    cc."DATE_LIMITE_PROPOSÉE",
                    cc.date_de_lanc,
                    cc.pv_cct,
                    cc.programme_ouverture_de_plis,
                    cc.jours_rest,
                    cc.date_ouverture_des_plis,
                    cc.status,
                    case 
                    WHEN  sysdate - cc.date_ouverture_des_plis > 30 THEN  'لقد مرت ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   أيام على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30 THEN 'لقد مرت ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   أيام على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود ( إن توفرت ) و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        WHEN sysdate - cc.date_ouverture_des_plis > 0 and  sysdate - cc.date_ouverture_des_plis < 20 THEN  'لقد مرت ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   أيام على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود ( إن توفرت ) و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        ELSE '🔴🔴🔴 🔴🔴🔴🔴وضع الملف غير عادي الرجاء التثبت'
                    
                   
                    end as stat,
                    CASE  
                        WHEN sysdate - cc.date_ouverture_des_plis > 30 THEN 'u-color-39'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30  THEN 'u-color-37'
                        WHEN sysdate - cc.date_ouverture_des_plis > 0 and  sysdate - cc.date_ouverture_des_plis < 20  THEN 'u-color-35'
                        ELSE 'u-color-44-contrast'
                    END AS COLOR_CELL,
                   CASE  
                        WHEN sysdate - cc.date_ouverture_des_plis > 30 THEN '🔴 عاجل جداً'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30  THEN '🟠 مهم'
                        WHEN sysdate - cc.date_ouverture_des_plis > 10 and  sysdate - cc.date_ouverture_des_plis < 20  THEN '🔵 عادي'
                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                    CASE
                        WHEN  sysdate - cc.date_ouverture_des_plis > 30 THEN 'fa-fire fa-1x fa-anim-flash'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30 THEN 'fa-alarm-snooze fa-anim-spin-step fam-information fam-is-warning fa-lg'
                        WHEN sysdate - cc.date_ouverture_des_plis > 10 and  sysdate - cc.date_ouverture_des_plis < 20 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                       CASE
                        WHEN sysdate - cc.date_ouverture_des_plis > 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                    cc.creer_par,
                    cc."DATE_CRÉATION",
                    cc.programme_de_lancement
                FROM cc
                WHERE cc.status = 5
                
                  AND NOT EXISTS (
                        SELECT 1
                        FROM contrats ct
                        WHERE ct.id_cc = cc.id
                  )
                
                
                /*
                SELECT
                    ID,
                    NOTE_TITLE   AS NOTETITLE,
                    NOTE_DETAILS AS NOTEDETAILS,
                    REMINDER_DATETIME,
                    TO_CHAR(REMINDER_DATETIME, 'DD Mon - HH24:MI') AS REMINDERFMT,
                
                    -- أيقونة ولون حسب الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'fa-bell text-danger'
                        WHEN 2 THEN 'fa-exclamation-triangle text-warning'
                        WHEN 1 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                
