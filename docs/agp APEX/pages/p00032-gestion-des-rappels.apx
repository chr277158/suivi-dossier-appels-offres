                             || '%) '
                    END AS MINUTES_LEFT,
                
                    -- نسبة التقدم (0-100) متاحة لو احتجتها لاحقاً
                    LEAST(100, GREATEST(0,
                        (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                              ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                    )) AS PROGRESS_PERCENT,
                
                    -- كلاس إضافي لو أردت تأثير خاص عند الاقتراب (اختياري)
                    CASE
                        WHEN ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440 <= 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                
                    -- لون شريط التقدم حسب الأهمية (لو استخدمته داخل CSS)
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'bg-danger'
                        WHEN 2 THEN 'bg-warning'
                        WHEN 1 THEN 'bg-info'
                        ELSE 'bg-secondary'
                    END AS PROGRESS_COLOR
                
                FROM USER_NOTES
                WHERE USER_ID = :P32_ROLE
                   AND NOT (IS_SENT = 'Y'
                           AND REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) < SYSDATE -1)
                ORDER BY IMPORTANCE_LEVEL DESC, REMINDER_DATETIME ASC;
