    process cleanup-expired-reminders (
        name: CLEANUP_EXPIRED_REMINDERS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    CLEANUP_EXPIRED_REMINDERS;
                    
                    apex_json.open_object;
                    apex_json.write('status', 'success');
                    apex_json.write('deleted', SQL%ROWCOUNT || ' تنبيه منتهي');
                    apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 18081601807731909
        }
    )

    process get-pending-reminders (
        name: GET_PENDING_REMINDERS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    apex_json.open_object;
                    apex_json.open_array('items');
                
                    FOR r IN (
                        SELECT id, note_title, note_details, importance_level
                        FROM user_notes
                        WHERE user_id = :APP_USER
                        AND reminder_datetime - (NVL(pre_reminder_mins,0)/1440) <= SYSDATE  -- حان وقت التنبيه
                        AND reminder_datetime >= SYSDATE - 1/24  -- الموعد لم ينتهِ تماماً (آخر ساعة)
                        AND rownum <= 10
                    )
                    LOOP
                        apex_json.open_object;
                        apex_json.write('ID', r.id);
                        apex_json.write('NOTE_TITLE', r.note_title);
                        apex_json.write('NOTE_DETAILS', r.note_details);
                        apex_json.write('IMPORTANCE_LEVEL', r.importance_level);
                        apex_json.close_object;
                    END LOOP;
                
                    apex_json.close_array;
                    apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 18081116742731904
        }
    )

    process get-user-role (
        name: Get_User_Role
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT role_static_id
                  INTO :P32_ROLE
                  FROM apex_appl_acl_user_roles
                 WHERE application_id = :APP_ID
                   AND user_name = :APP_USER
                 FETCH FIRST 1 ROW ONLY; -- Sécurité si l'utilisateur a plusieurs rôles
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 24330222641495317
        }
    )

    process mark-reminder-sent (
        name: MARK_REMINDER_SENT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_reminder_id NUMBER := APEX_APPLICATION.G_X01;
                BEGIN
                    UPDATE user_notes 
                    SET is_sent = 'Y',
                        last_updated = SYSDATE
                    WHERE id = l_reminder_id 
                    AND user_id = :APP_USER;
                    
                    IF SQL%ROWCOUNT > 0 THEN
                        apex_json.open_object;
                        apex_json.write('status', 'success');
                        apex_json.write('message', 'تم تحديث حالة التنبيه');
                        apex_json.close_object;
                    ELSE
                        apex_json.open_object;
                        apex_json.write('status', 'error');
                        apex_json.write('message', 'لم يتم العثور على التنبيه');
                        apex_json.close_object;
                    END IF;
                END;
                
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 18081021940731903
        }
    )

)

