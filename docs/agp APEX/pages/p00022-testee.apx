    region etat-sur-le-nombre-d-utilisateurs (
        name: Etat sur le nombre d'utilisateurs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.role_name, (select count(*) from apex_appl_acl_user_roles ur where r.role_id = ur.role_id) user_count, r.role_id
                from apex_appl_acl_roles r
                where r.application_id = :APP_ID
                group by r.role_name, r.role_id
                order by 2 desc, 1
                ```
        }
        layout {
            sequence: 33
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
                t-Region--noPadding
            ]
        }
        componentAppearance {
            template: @/value-attribute-pairs-row
            templateOptions: [
                #DEFAULT#
                t-AVPList--rightAligned
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: aucune donnée n'a été trouvée
        }

        column ROLE_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Role Id
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column ROLE_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Role Name
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column USER_COUNT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: User Count
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            sorting {
                sortable: false
            }
        )

    )

    region graphique-des-principaux-utilisateurs (
        name: Graphique des principaux utilisateurs
        type: chart
        layout {
            sequence: 83
            parentRegion: @nouveau-2
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--hiddenOverflow
            ]
        }
        serverSideCondition {
            type: item=value
            item: P22_VIEW_AS
            value: CHART
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 600
        }
        value {
            pieChartOtherThreshold: 0.02
            format: decimal
            decimalPlaces: 0
        }
        animation {
            onDisplay: none
        }
        legend {
            show: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ){ 
                
                    this.pieSliceLabel = function(dataContext) {
                        var series_name,
                            percent = Math.round(dataContext.value/dataContext.totalValue*100);
                        
                        if ( dataContext.seriesData ) {
                            series_name = dataContext.seriesData.name;
                        } else {
                            series_name = 'Other';
                        }
                        return series_name + " " + percent + "% ( " + dataContext.value + " )";
                    }
                    
                    // Set chart initialization options 
                    options.dataLabel = pieSliceLabel; 
                    return options; 
                }
                ```
        }

        series série (
            name: Série 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select userid_lc as userid,
                           count(*) as page_views
                      from apex_activity_log
                     where flow_id     = :app_id
                       and time_stamp >= sysdate - ( 1/24/60/60 * :P22_TIMEFRAME )
                       and userid     is not null
                     group by userid_lc
                     order by 2
                    ```
                pageItemsToSubmit: P22_TIMEFRAME
            }
            columnMapping {
                label: USERID
                value: PAGE_VIEWS
            }
            label {
                show: true
                position: outsideSlice
            }
        )

    )

    region informations-sur-la-liste-de-contrôle-d-accès (
        name: Informations sur la liste de contrôle d'accès
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                    l_acl_scope varchar2(45);
                begin
                    l_acl_scope := apex_app_setting.get_value( p_name => 'ACCESS_CONTROL_SCOPE' );
                
                    if l_acl_scope = 'ALL_USERS' then
                        sys.htp.p( apex_lang.message('APEX.FEATURE.ACL.INFO.ALL_USERS') );
                    elsif l_acl_scope = 'ACL_ONLY' then
                        sys.htp.p( apex_lang.message('APEX.FEATURE.ACL.INFO.ACL_ONLY') );
                    else
                        sys.htp.p( apex_lang.message('APEX.FEATURE.ACL.INFO.ACL_VALUE_INVALID', l_acl_scope) );
                    end if;
                end;
                ```
        }
        layout {
            sequence: 23
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--noIcon
                t-Alert--warning
                t-Alert--accessibleHeading
            ]
            cssClasses: margin-sm
        }
    )

