                        P8_REF_AE: #REF_AE#
                    }
                    action: resetPagination
                }
                linkText: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
        )

    )

    region enregistrements-maître (
        name: Enregistrements maître
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P25_ID', p_values => "ID") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P25_ID,'0') = "ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("REF_AO", 1, 50)||( case when length("REF_AO") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("STATUS", 1, 50)||( case when length("STATUS") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "CC" x
                where (:P25_SEARCH is null
                        or upper(x."REF_AO") like '%'||upper(:P25_SEARCH)||'%'
                        or upper(x."STATUS") like '%'||upper(:P25_SEARCH)||'%'
                    )
                order by "REF_AO"
                
                
                ```
            pageItemsToSubmit: P25_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Aucune donnée n'a été trouvée.</div>
        }

