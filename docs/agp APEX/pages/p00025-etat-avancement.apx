    dynamicAction effectuez-la-recherche (
        name: Effectuez la recherche
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P25_SEARCH
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @enregistrements-maître
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

