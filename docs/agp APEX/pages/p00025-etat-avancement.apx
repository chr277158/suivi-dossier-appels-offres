            location: localDatabase
            tableName: DEMANDE_CLARIFICATION
            includeRowidColumn: true
            whereClause: "REF_AE" = :P25_REF
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P25_ID
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        pagination {
            type: nextAndPreviousLinks
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: Aucune donnée n'a été trouvée.
        }
        componentAdvanced {
            stripHtml: true
        }

