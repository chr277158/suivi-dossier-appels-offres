    dynamicAction boîte-de-dialogue-affichage-fermée (
        name: Boîte de dialogue affichage fermée
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @remarques
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('ٌRemarque mise(s) \u00E0 jour.');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @remarques
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

