page 25 (
    name: etat avancement
    alias: ETAT-AVANCEMENT
    title: "etat avancement "
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region aucun-enregistrement-sélectionné (
        name: Aucun enregistrement sélectionné
        type: staticContent
        source {
            htmlCode: Aucun enregistrement sélectionné
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P25_ID
        }
    )

    region cc (
        name: Cc
        type: classicReport
        source {
            location: localDatabase
            tableName: TABLE_TOTAL
            whereClause: "ID" = :P25_ID
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                js-master-region
                js-detail-region
            ]
            renderComponents: belowContent
        }
        headerAndFooter {
            headerText: &REF_AO.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P25_ID
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--hideNulls
                t-AVPList--leftAligned
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: "لم يتم تحديد أي ملف لحد الآن الرجاء إختيار ملف لإضهار التفاصيل "
        }
        componentAdvanced {
            stripHtml: true
            sortNulls: first
        }

