    pageItem P20_المكلف_بالملف (
        type: selectOne
        label {
            label: المكلف بالملف
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select T_USER.NOM as NOM,
                T_USER.NOM as N
                 from T_USER 
                 where T_USER.GROUPE = 'user'
                ```
        }
        layout {
            sequence: 290
            region: @تحيين-المعطيات
            slot: regionBody
            alignment: left
            column: 5
            columnSpan: 4
            columnAttributes: "background-color":"rgb37
        }
        appearance {
