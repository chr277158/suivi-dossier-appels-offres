    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-lg fa-check-square
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P20_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 13500760742265889
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 13510548637751028
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-تحيين-المعطيات (
        name: Initialize form تحيين المعطيات
        type: formInitialization
        formRegion: @تحيين-المعطيات
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13497897591265885
        }
    )

    process process-form-تحيين-المعطيات (
        name: Process form تحيين المعطيات
        type: formAutoRowProcessing
        formRegion: @تحيين-المعطيات
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13498238882265887
