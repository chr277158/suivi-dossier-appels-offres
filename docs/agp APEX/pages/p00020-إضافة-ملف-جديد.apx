page 20 (
    name: إضافة ملف جديد
    alias: إضافة-ملف-جديد
    title: إضافة ملف جديد
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#jquery.maskedinput.min.js
        executeWhenPageLoads:
            ```javascript-browser
            $("#P20_NB").mask("A*.##.#.####");
            //$("#P4_BUDGET").mask("## ###.###,###")
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region تحيين-المعطيات (
        name: " تحيين المعطيات"
        title: " "
        type: form
        source {
            location: localDatabase
            tableName: SP
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P20_EXP__INV (
        type: selectList
        label {
            label: Exp  Inv
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:EXP;EXP,INV;INV
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @تحيين-المعطيات
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @تحيين-المعطيات
            column: EXP__INV
            dataType: varchar2
        }
    )

    pageItem P20_ID (
        type: hidden
        layout {
            sequence: 20
            region: @تحيين-المعطيات
            slot: regionBody
        }
        source {
            formRegion: @تحيين-المعطيات
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P20_NB (
        type: textField
        label {
            label: "عدد الصفقة "
            alignment: left
        }
        settings {
            textCase: upper
        }
        layout {
            sequence: 10
            region: @تحيين-المعطيات
            slot: regionBody
            alignment: left
            column: 1
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: A#.##.####
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @تحيين-المعطيات
            column: عدد
            dataType: varchar2
        }
        help {
            helpText: format par défaut est AX.XX.x.XXXX ou  X:est un chiffre
        }
    )

