    pageItem P48_PERIODE (
        type: selectList
        label {
            label: Nouveau
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -LEVEL + 2), 'MM/YYYY') AS display_value,
                       TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -LEVEL + 2), 'MM/YYYY') AS return_value
                FROM DUAL
                CONNECT BY LEVEL <= 24
                ORDER BY TO_DATE(return_value, 'MM/YYYY') DESC;
                ```
        }
        layout {
            sequence: 33
            slot: body
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    dynamicAction ajout-deux-point-bebut-fin (
        name: ajout_deux_point_bebut_fin
        execution {
            sequence: 30
        }
        when {
            selectionType: columns
            interactiveGrid: @nouveau
            columns: [
                DEBUT
                FIN
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    let input = this.triggeringElement;
                    
                    // Sécurité 1 : On évite les déclenchements sur les conteneurs internes d'APEX
                    if (!input || typeof input.value !== 'string') {
                        return; 
                    }
                    
                    let val = input.value.replace(/\D/g, ''); // Garde uniquement les chiffres
                    
                    // Sécurité 2 : Si le champ est vide, on s'arrête
                    if (!val || val.trim() === "") {
                        return;
                    }
                    
                    let formatted = "";
                    let isValid = true;
                    
                    // 1. Auto-correction intelligente
                    if (val.length === 1) {
                        formatted = "0" + val + ":00"; // Ex: "8" -> "08:00"
                    } 
                    else if (val.length === 2) {
                        formatted = val + ":00";        // Ex: "14" -> "14:00"
                    } 
                    else if (val.length === 3) {
                        formatted = "0" + val.substring(0, 1) + ":" + val.substring(1); // Ex: "830" -> "08:30"
                    } 
                    else if (val.length >= 4) {
                        formatted = val.substring(0, 2) + ":" + val.substring(2, 4);    // Ex: "1430" -> "14:30"
                    }
                    
                    // 2. Validation de cohérence (Max 23:59)
                    let parts = formatted.split(":");
                    let heures = parseInt(parts[0], 10);
                    let minutes = parseInt(parts[1], 10);
                    
                    if (heures > 23 || minutes > 59) {
                        isValid = false;
                    }
                    
                    // 3. Application du résultat
                    if (!isValid) {
                        input.value = ""; // On efface la mauvaise valeur
                        
                        // Alerte rouge APEX
                        apex.message.showErrors([
                            {
                                type:       "error",
                                location:   "page",
                                message:    "L'heure saisie (" + formatted + ") est invalide. Veuillez entrer une heure correcte entre 00:00 et 23:59.",
                                unsafe:     false
                            }
                        ]);
                    } else {
                        if (input.value !== formatted) {
                            input.value = formatted;
                        }
                    
                        // Sauvegarde dans le modèle de la grille
                        let region = apex.region("Nouveau");
                        if (region) {
                            let view = region.call("getViews", "grid");
                            if (view && view.model) {
                                let model = view.model;
                                let record = model.getRecordForValue(input) || view.getSelectedRecords()[0];
                                
                                if (record) {
                                    let columnName = input.getAttribute('name') || input.id;
                                    if (model.getValue(record, columnName) !== formatted) {
                                        model.setValue(record, columnName, formatted);
                                    }
                                }
                            }
                        }
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cal-nbr-h (
        name: Cal_nbr_h
        execution {
            sequence: 5
        }
        when {
            selectionType: region
            region: @nouveau
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    setTimeout(function () {
                        var view  = apex.region("GRILLE").call("getViews", "grid");
                        if (!view || !view.model) return;
                        
                        var model = view.model;
                    
                        model.forEach(function(record){
                            if (record.meta && record.meta.deleted) {
                                return;
                            }
                    
                            var debut = model.getValue(record, "DEBUT");
                            var fin   = model.getValue(record, "FIN");
                    
                            if (!debut || !fin) {
                                return;
                            }
                    
                            // Vérification du format avant calcul
                            var regex = /^([01]?[0-9]|2[0-3]):[0-5][0-9]$/;
                            if (!regex.test(debut) || !regex.test(fin)) {
                                return;
                            }
                    
                            var d = debut.split(":");
                            var f = fin.split(":");
                    
                            var debutMin = parseInt(d[0], 10) * 60 + parseInt(d[1], 10);
                            var finMin   = parseInt(f[0], 10) * 60 + parseInt(f[1], 10);
                    
                            var diffMinutes = finMin - debutMin;
                    
                            // Gestion du passage à minuit en JavaScript également
                            if (diffMinutes < 0) {
                                diffMinutes = diffMinutes + (24 * 60);
                            }
                    
                            // Traduction exacte en JavaScript du calcul de notre trigger (Arrondi à 0.5 près)
                            var rounded = Math.round((diffMinutes / 60) * 2) / 2;
                    
                            // Mise à jour de la colonne NBR_H à l'écran si la valeur calculée est différente
                            if (model.getValue(record, "NBR_H") != rounded) {
                                model.setValue(record, "NBR_H", rounded);
                                model.metadataChanged(record);
                            }
                        });
                    }, 150);
                    ```
            }
            affectedElements {
                selectionType: columns
                columns: [
                    DEBUT
                    FIN
                    NBR_H
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction nouveau (
        name: Nouveau
        execution {
            sequence: 10
        }
        when {
            selectionType: region
            region: @nouveau
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var grid   = apex.region('GRILLE').call('getViews', 'grid');
                    var model  = grid.model;
                    var record = grid.getSelectedRecords();
                    
                    if (record && record.length > 0) {
                    
                        var row = record[0];
                    
                        function val(col) {
                            return model.getValue(row, col) || '';
                        }
                    
                        // région FICHE
                        var t = $('#heur-a4');
                    
                        t.find('[data-field="mat"]').text(val('MATRICULE'));
                        t.find('[data-field="user"]').text(val('NOM'));
                        t.find('[data-field="date"]').text(val('DATE_J'));
                        t.find('[data-field="DEBUT"]').text(val('DEBUT'));
                        t.find('[data-field="FIN"]').text(val('FIN'));
                        t.find('[data-field="nbr_h"]').text(val('NBR_H'));
                        t.find('[data-field="rem"]').text(val('REM'));
                    
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    setTimeout(function () {
                    
                        var grid  = apex.region("GRILLE").call("getViews", "grid");
                        var model = grid.model;
                    
                        var html = "";
                        var rows = [];
                    
                        model.forEach(function(record) {
                    
                            var date_j = model.getValue(record, "DATE_J");
                    
                            if (date_j) {
                    
                                rows.push({
                                    matricule : model.getValue(record, "MATRICULE") || "",
                                    nom       : model.getValue(record, "NOM") || "",
                                    date_j    : date_j,
                                    debut     : model.getValue(record, "DEBUT") || "",
                                    fin       : model.getValue(record, "FIN") || "",
                                    nbr_h     : model.getValue(record, "NBR_H") || "",
                                    rem       : model.getValue(record, "REM") || ""
                                });
                            }
                        });
                    
                        var totalRows = rows.length;
                    
                        if (totalRows === 0) {
                            $("#liste-heures").html("");
                            return;
                        }
                    
                        // hauteur totale du tableau
                        var totalHeight = 400;
                    
                        // hauteur fixe des lignes
                        var rowHeight = 30;
                    
                        // espace utilisé
                        var usedHeight = totalRows * rowHeight;
                    
                        // espace restant
                        var emptyHeight = totalHeight - usedHeight;
                    
                        if (emptyHeight < 30) {
                            emptyHeight = 30;
                        }
                    
                        rows.forEach(function(r, index) {
                    
                            html += `
                                <tr style="height:${rowHeight}pt;">
                            `;
                    
                            // MATRICULE + NOM une seule fois
                            if (index === 0) {
                    
                                html += `
                                    <td rowspan="${totalRows + 1}"
                                        style="border:1px solid black; text-align:center; vertical-align:middle; font-size: 16pt;">
                                        ${r.matricule}
                                    </td>
                    
                                    <td rowspan="${totalRows + 1}"
                                        style="border:1px solid black; text-align:center; vertical-align:middle; font-size: 16pt;">
                                        ${r.nom}
                                    </td>
                                `;
                            }
                    
                            html += `
                                <td style="border:1px solid black;text-align:center;">
                                    ${r.date_j}
                                </td>
                    
                                <td style="border:1px solid black;text-align:center;">
                                    ${r.nbr_h}
                                </td>
                    
                                <td colspan="3" style="border:1px solid black;text-align:center; width:115.2pt;">
                                    ${r.debut} -  ${r.fin}
                                </td>
                               
                            `;
                    
                            // REM une seule fois
                            if (index === 0) {
                    
                                html += `
                                    <td rowspan="${totalRows + 1}"
                                        style="border:1px solid black;text-align:center;vertical-align:top;">
                                        ${r.rem}
                                    </td>
                                `;
                            }
                    
                            html += `</tr>`;
                        });
                    
                        // dernière ligne vide
                    html += `
                        <tr style="height:${emptyHeight}pt;">
                    
                            <td colspan="3" style="border:1px solid black; position:relative; padding:0; background: linear-gradient(to bottom right, transparent 49.20%, black 40%, transparent 50.20% );">
                                &nbsp;
                            </td>
                    
                        </tr>
                        `;
                    
                        $("#liste-heures").html(html);
                    
                    }, 100);
                    ```
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction nouveau-2 (
        name: Nouveau_3
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    setTimeout(function () {
                    
                        var grid  = apex.region("GRILLE").call("getViews", "grid");
                        var model = grid.model;
                    
                        var html = "";
                        var rows = [];
                    
                        model.forEach(function(record) {
                    
                            var date_j = model.getValue(record, "DATE_J");
                    
                            if (date_j) {
                    
                                rows.push({
                                    matricule : model.getValue(record, "MATRICULE") || "",
                                    nom       : model.getValue(record, "NOM") || "",
                                    date_j    : date_j,
                                    debut     : model.getValue(record, "DEBUT") || "",
                                    fin       : model.getValue(record, "FIN") || "",
                                    nbr_h     : model.getValue(record, "NBR_H") || "",
                                    rem       : model.getValue(record, "REM") || ""
                                });
                            }
                        });
                    
                        var totalRows = rows.length;
                    
                        if (totalRows === 0) {
                            $("#liste-heures").html("");
                            return;
                        }
                    
                        // hauteur totale du tableau
                        var totalHeight = 400;
                    
                        // hauteur fixe des lignes
                        var rowHeight = 30;
                    
                        // espace utilisé
                        var usedHeight = totalRows * rowHeight;
                    
                        // espace restant
                        var emptyHeight = totalHeight - usedHeight;
                    
                        if (emptyHeight < 30) {
                            emptyHeight = 30;
                        }
                    
                        rows.forEach(function(r, index) {
                    
                            html += `
                                <tr style="height:${rowHeight}pt;">
                            `;
                    
                            // MATRICULE + NOM une seule fois
                            if (index === 0) {
                    
                                html += `
                                    <td rowspan="${totalRows + 1}"
                                        style="border:1px solid black; text-align:center; vertical-align:middle; font-size: 16pt;">
                                        ${r.matricule}
                                    </td>
                    
                                    <td rowspan="${totalRows + 1}"
                                        style="border:1px solid black; text-align:center; vertical-align:middle; font-size: 16pt;">
                                        ${r.nom}
                                    </td>
                                `;
                            }
                    
                            html += `
                                <td style="border:1px solid black;text-align:center;">
                                    ${r.date_j}
                                </td>
                    
                                <td style="border:1px solid black;text-align:center;">
                                    ${r.nbr_h}
                                </td>
                    
                                <td colspan="3" style="border:1px solid black;text-align:center; width:115.2pt;">
                                    ${r.debut} -  ${r.fin}
                                </td>
                               
                            `;
                    
                            // REM une seule fois
                            if (index === 0) {
                    
                                html += `
                                    <td rowspan="${totalRows + 1}"
                                        style="border:1px solid black;text-align:center;vertical-align:top;">
                                        ${r.rem}
                                    </td>
                                `;
                            }
                    
                            html += `</tr>`;
                        });
                    
                        // dernière ligne vide
                    html += `
                        <tr style="height:${emptyHeight}pt;">
                    
                            <td colspan="3" style="border:1px solid black; position:relative; padding:0; background: linear-gradient(to bottom right, transparent 49.20%, black 40%, transparent 50.20% );">
                                &nbsp;
                            </td>
                    
                        </tr>
                        `;
                    
                        $("#liste-heures").html(html);
                    
                    }, 100);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    validation debut-v (
        name: debut_v
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @nouveau
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                IF :DEBUT IS NOT NULL THEN
                    -- Vérifie le format global et les limites des heures (00-23) et minutes (00-59)
                    IF NOT REGEXP_LIKE(:DEBUT, '^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$') THEN
                        RETURN 'L''heure doit être au format HH24:MI (ex: 14:30) et valide.';
                    END IF;
                END IF;
                RETURN NULL;
                ```
        }
        error {
            associatedColumn: DEBUT
        }
    )

