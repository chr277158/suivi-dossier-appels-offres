    region المجمع-الكيميائي-التونسي (
        name: المجمع الكيميائي التونسي
        type: staticContent
        source {
            htmlCode:
                ```html
                    <style>
                        body {
                            font-family: 'Times New Roman';
                            font-size: 12pt
                        }
                @media print { .ig-toolbar, .t-Body-nav, .t-Header { display:none !important; }
