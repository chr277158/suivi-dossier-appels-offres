                       NOM, 
                       DATE_J, 
                       DEBUT, 
                       FIN, 
                       NBR_H, 
                       REM,
                       PERIODE_RH
                FROM   HEUR_SPP
                WHERE  MATRICULE = :P0_MAT
                  AND  (:P48_PERIODE IS NULL OR PERIODE_RH = :P48_PERIODE);
