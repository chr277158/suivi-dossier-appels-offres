page 34 (
    name: جدول الاشغال
    alias: جدول-الاشغال
    title: جدول الاشغال
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* 1) Donne une hauteur plus grande à la zone header (optionnel) */
            .myClass .a-GV-header{
              height: 60px;         /* Ajuste selon ton besoin */
              line-height: 50px;     /* Optionnel: vertical align/centrage */
              padding: 5px;
              white-space: normal;   /* Autorise le retour à la ligne */
              overflow-wrap: break-word;
              word-wrap: break-word;
            }
            
            /* 2) Force le texte du libellé à se wrapper */
            .myClass .a-GV-header .a-GV-headerLabel{
              white-space: normal;
              overflow-wrap: break-word;
              word-wrap: break-word;
              height: auto;
              line-height: 1.2;      /* Plus naturel pour du multi-ligne */
              padding: 5px;
            }
            .a-GV-header{ 
                pointer-events: none;
            }
            $("#P6_REF_AO").mask("A*.##.#.####");
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region enregistrements-maître (
        name: Enregistrements maître
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT
                    "ANNEE",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P34_ANNEE', p_values => "ANNEE") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P34_ANNEE,'0') = "ANNEE"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    "ANNEE" LIST_TITLE, -- Puisque c'est groupé, on affiche juste l'année
                    null LIST_TEXT,     -- On met NULL ici car on ne peut pas afficher un texte spécifique si plusieurs lignes sont combinées
                    null LIST_BADGE
                from "SUIVI" x
                where (
                        upper(x."ANNEE") like '%'||upper(:P34_SEARCH)||'%'
                        
                      )
                order by "ANNEE"
                ```
            pageItemsToSubmit: :P34_SEARCH
        }
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Aucune donnée n'a été trouvée.</div>
        }

        column ANNEE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
