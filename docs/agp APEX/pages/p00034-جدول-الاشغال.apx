        column ETAT (
            type: hidden
            layout {
                sequence: 170
            }
            source {
                type: none
            }
        )

        column GT (
            type: displayOnly
            heading {
                alignment: center
            }
            settings {
                format: html
            }
            layout {
                sequence: 160
                columnAlignment: center
                stretch: never
            }
            source {
                type: sqlExpression
                sqlExpression:
                    ```sql
                    CASE WHEN ETAT = 'OK' THEN 
                         '<span class="fa fa-check-circle fa-2x" style="color:green"></span>'
                    WHEN ETAT = 'KO' THEN 
                         '<span class="fa fa-times-circle  fa-2x fa-anim-flash" style="color:red"></span>'
                    WHEN ETAT = 'WAIT' THEN 
                         '<span class="fa fa-circle-o-notch fa-anim-spin fa-lg" style="color:orange"></span>'
                    ELSE 
                         '<span class="fa fa-question-circle" style="color:gray"></span>'
                    END
                    
                    ```
                dataType: varchar2
            }
            columnFilter {
                enabled: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
                hide: false
            }
        )

