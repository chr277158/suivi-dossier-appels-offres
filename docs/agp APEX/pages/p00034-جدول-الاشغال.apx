    region rechercher (
        name: Rechercher
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: [
                search-region
                padding-md
            ]
        }
    )

    region جدول-الاشغال (
        name: جدول الاشغال
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT s.ID,
                       s."الكلفة_التقديرية",
                       s."نوعية_الطلب",
                       s."اللجنة_المختصة",
                       s."الاجراءات",
                       s."طريقة_ابرام_الصفقة",
                       s."آجال_الانجاز",
                       s."المكلف_بالملف",
                       s."رقم_الاستشارة",
                       s."تاريخ_بداية_معالجة_الملف_الجديد",
                       CASE 
                         WHEN c.REF_AO IS NOT NULL  THEN 'OK'
                         WHEN  c.REF_AO IS  NULL  AND s."تاريخ_بداية_معالجة_الملف_الجديد" < SYSDATE THEN 'WAIT'
                        
                         ELSE 'KO'
                       END AS ETAT,
                       s."التاريخ_نهاية_العقد_الجاري",
                       s."موضوع_الصفقة",
                       s.ANNEE
                FROM SUIVI s
                LEFT JOIN CC c
                       ON c.REF_AO = s."رقم_الاستشارة"
                    WHERE s.ANNEE = :P34_ANNEE   ;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnCssClasses: myClass
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        messages {
            whenNoDataFound: الرجاء تحديد السنة لعرض المعطيات
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
            addButtonLabel: إضافة ملف جديد
        }
        enableUsersTo {
            savePublicReport: true
            savePublicReportAuthorization: @droits-de-contribution
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
