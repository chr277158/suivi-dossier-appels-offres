page 54 (
    name: imprim_Congé
    alias: IMPRIM-CONGÉ
    title: imprim_Congé
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function saveAndPrint() {
            
                apex.server.process(
                    "SAVE_CONGE",
                    {
                        pageItems:
                            "#P47_MATRICULE," +
                            "#P47_NOM_PRENOM," +
                            "#P47_SERVICE," +
                            "#P47_FONCTION," +
                            "#P47_TYPE_CONGE," +
                            "#P47_NBR_JOURS," +
                            "#P47_NBR_FERIES," +
                            "#P47_DATE_DEBUT," +
                            "#P47_DATE_FIN," +
                            "#P47_SOLDE_AVANT," +
                            "#P47_SOLDE_APRES," +
                            "#P47_ADRESSE_CONGE," +
                            "#P47_TELEPHONE"
                    },
                    {
            
                        dataType: "text",
            
                        success: function(pData) {
            
                            if (pData.trim() === "success") {
            
                                printRegion('formulaire-a4');
            
                            } else {
            
                                alert(pData);
            
                            }
                        },
            
                        error: function(xhr, status, error) {
            
                            console.log(xhr.responseText);
            
                            alert("Erreur : " + error);
            
                        }
                    }
                );
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region nouveau (
        name: Nouveau
        type: form
        source {
            location: localDatabase
            tableName: T_CONGE
        }
        layout {
            sequence: 43
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region titre (
        name: TITRE
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                  * { box-sizing: border-box; margin: 0; padding: 0; }
                  body { font-family: "Times New Roman", serif; background: #f0f0f0; }
