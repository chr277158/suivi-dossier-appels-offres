page 6 (
    name: creer_nouveau
    alias: CREER-NOUVEAU
    title: إنشاء صفقة جديدة
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#jquery.maskedinput.min.js
        executeWhenPageLoads:
            ```javascript-browser
            $("#P6_REF_AO").mask("A*.##.#.####");
            //$("#P6_BUDGET").mask("## ### ###,###")
            // Dans "Execute when Page Loads"
            /*new AutoNumeric('#P6_BUDGET', {
                digitGroupSeparator: ' ',
                decimalCharacter: ',',
                decimalPlaces: 3
            });*/
            ```
    }
    security {
        authorizationScheme: @droits-de-lecteur
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cc (
        name: Cc
        type: form
        source {
            location: localDatabase
            tableName: CC
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: add
        }
        editAuthorization {
            add: @droits-de-lecteur
        }
    )

    region info-principales (
        name: "Info Principales "
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @cc
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        accessibility {
            useLandmark: false
        }
        settings {
            expandShortcuts: true
        }
    )

    region n (
        name: "N "
        type: form
        source {
            location: localDatabase
            tableName: FICHIER_LNCEMENT
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region تحيين-المعطيات (
        name: " تحيين المعطيات"
        title: " "
        type: form
        source {
            location: localDatabase
            tableName: SP
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: add
        }
        editAuthorization {
            add: @droits-de-lecteur
        }
    )

