    dynamicAction activation-modif-admin-zone (
        name: activation_modif_admin_zone1
        execution {
            sequence: 140
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @معلومات-أساسية-عن-الصفقة
        }
        clientSideCondition {
            type: itemIsInList
            item: P0_MAT
            list: [
                91591
                92491
            ]
        }

        action activation (
            name: activation
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P23_BUDGET
                    P23_DÉTAIL_DE_RÉPONSE
                    P23_NATURE_DE_DEPENSE
                    P23_OBJET_CCT
                    نوعية الطلب
                    P23_طريقة_ابرام_الصفقة
                    اللجنة المختصة
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P23_BUDGET
                    P23_DÉTAIL_DE_RÉPONSE
                    P23_NATURE_DE_DEPENSE
                    P23_OBJET_CCT
                    نوعية الطلب
                    P23_طريقة_ابرام_الصفقة
                    اللجنة المختصة
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

