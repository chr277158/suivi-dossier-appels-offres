    dynamicAction new (
        name: New_3
        execution {
            sequence: 110
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.util.getTopApex().jQuery(".ui-dialog-content").dialog("option", "title", "Référence Dossier  " + $v("P23_NB") );
            }
            execution {
