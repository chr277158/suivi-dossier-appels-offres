page 33 (
    name: edit note
    alias: EDIT-NOTE
    title: edit note
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region edit-note (
        name: edit note
        type: form
        source {
            location: localDatabase
            tableName: USER_NOTES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P33_CREATED_ON_1 (
        type: displayOnly
        label {
            label: Created On
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 110
            region: @edit-note
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @edit-note
            column: CREATED_ON
            dataType: date
        }
    )

    pageItem P33_ID_1 (
        type: hidden
        layout {
            sequence: 10
            region: @edit-note
            slot: regionBody
        }
        source {
            formRegion: @edit-note
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P33_IMPORTANCE_LEVEL_1 (
        type: selectList
        label {
            label: مستوى أهمية التذكير
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:عادي;1,مهم ;2,مهم جدا;3
        }
        layout {
            sequence: 70
            region: @edit-note
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @edit-note
            column: IMPORTANCE_LEVEL
            dataType: number
        }
    )

    pageItem P33_IS_SENT_1 (
        type: hidden
        layout {
            sequence: 100
            region: @edit-note
            slot: regionBody
        }
        source {
            formRegion: @edit-note
            column: IS_SENT
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P33_LAST_UPDATED_1 (
        type: hidden
        layout {
            sequence: 120
            region: @edit-note
            slot: regionBody
        }
        source {
            formRegion: @edit-note
            column: LAST_UPDATED
            dataType: date
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_NOTE_DETAILS_1 (
        type: textarea
        label {
            label: نص التذكير
            alignment: left
        }
        layout {
            sequence: 80
            region: @edit-note
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 300
            height: 5
        }
        source {
            formRegion: @edit-note
            column: NOTE_DETAILS
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P33_NOTE_TITLE_1 (
        type: textField
        label {
            label: موضوع التذكير
            alignment: left
        }
        layout {
            sequence: 30
            region: @edit-note
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @edit-note
            column: NOTE_TITLE
            dataType: varchar2
        }
    )

    pageItem P33_PRE_REMINDER_MINS_1 (
        type: selectList
        label {
            label: الفترة قبل التذكير بالدقائق
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:قبل 1 دقيقة;1,قبل 5 دقائق;5,قبل 15 دقيقة;15,قبل 30 دقيقة;30,قبل  45 دقيقة;45,قبل  ساعة;60,قبل ساعتين;120
        }
        layout {
            sequence: 60
            region: @edit-note
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @edit-note
            column: PRE_REMINDER_MINS
            dataType: number
        }
        help {
            helpText: تسمح للمستخدم بتحديد متى يريد أن يُنبه قبل وقت التذكير الرئيسي.
        }
    )

    pageItem P33_REMINDER_DATETIME_1 (
        type: datePicker
        label {
            label: وقت التذكير الرئيسي
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 50
            region: @edit-note
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @edit-note
            column: REMINDER_DATETIME
            dataType: date
        }
    )

    pageItem P33_USER_ID_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @edit-note
            slot: regionBody
        }
        source {
            formRegion: @edit-note
            column: USER_ID
            dataType: varchar2
        }
        default {
            type: item
            item: P0_MAT
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P33_ID_1
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P33_ID_1
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P33_ID_1
        }
    )

    dynamicAction hide-creared-on (
        name: "hide creared on "
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P33_CREATED_ON_1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P33_CREATED_ON_1
            }
            execution {
                sequence: 10
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 18054684142677014
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-edit-note (
        name: Initialize form edit note
        type: formInitialization
        formRegion: @edit-note
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18053882912677014
        }
    )

    process process-form-edit-note (
        name: Process form edit note
        type: formAutoRowProcessing
        formRegion: @edit-note
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 18054242471677014
        }
    )

)

