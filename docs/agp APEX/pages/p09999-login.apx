page 9999 (
    name: Page de connexion
    alias: LOGIN
    title: Cc - Connexion
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region connexion (
        name: "Connexion "
        type: staticContent
        source {
            htmlCode: <img src="#APP_FILES#icons/app-icon-512.png" alt="Girl in a jacket" style="width:400px;height:200px;">
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: [
                #DEFAULT#
                t-Login-region--headerHidden js-removeLandmark
            ]
            icon: fa-lg fa-collapsible
            renderComponents: belowContent
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
        settings {
            expandShortcuts: true
        }
    )

    pageItem P9999_PASSWORD (
        type: password
        label {
            label: Mot de passe
            alignment: left
        }
        layout {
            sequence: 50
            region: @connexion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-key
            width: 40
            valuePlaceholder: Mot de passe
        }
        validation {
            maxLength: 100
        }
        sessionState {
            storage: request
        }
    )

    pageItem P9999_PERSISTENT_AUTH (
        type: checkbox
        label {
            label: Se souvenir de moi
            alignment: left
        }
        layout {
            sequence: 70
            region: @connexion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_authentication.persistent_auth_enabled
        }
    )

    pageItem P9999_REMEMBER (
        type: checkbox
        label {
            label: Mémoriser le nom utilisateur
            alignment: left
        }
        layout {
            sequence: 60
            region: @connexion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_authentication.persistent_cookies_enabled and not apex_authentication.persistent_auth_enabled
        }
    )

    pageItem P9999_USERNAME (
        type: textField
        label {
            label: Nom Utilisateur
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @connexion
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 40
            valuePlaceholder: Nom utilisateur
        }
        validation {
            maxLength: 100
        }
        sessionState {
            storage: request
        }
    )

    button login (
        buttonName: LOGIN
        label: Ouvrir une session
        layout {
            sequence: 40
            region: @connexion
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process définir-le-cookie-de-nom-utilisateur (
        name: Définir le cookie de nom utilisateur
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.login(
                    p_username => :P9999_USERNAME,
                    p_password => :P9999_PASSWORD,
                    p_set_persistent_auth => nvl(:P9999_PERSISTENT_AUTH, 'N') = 'Y' );
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 61391462470378275106
        }
    )

    process effacer-le-cache-des-pages (
        name: Effacer le cache des pages
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 61391463255395275106
        }
    )

    process login (
        name: Login
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.login(
                    p_username => :P9999_USERNAME,
                    p_password => :P9999_PASSWORD,
                    p_set_persistent_auth => nvl(:P9999_PERSISTENT_AUTH, 'N') = 'Y' );
                    :P0_MAT := :P9999_USERNAME;
                        SELECT NOM into :P0_USER
                    from T_USER where MATRICULE = :P9999_USERNAME; 
                
                 
                  
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 61391462081472275105
        }
    )

    process obtenir-le-cookie-de-nom-utilisateur (
        name: Obtenir le cookie de nom utilisateur
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P9999_USERNAME := apex_authentication.get_login_username_cookie;
                :P9999_REMEMBER := case when :P9999_USERNAME is not null then 'Y' end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 61391462870399275106
        }
    )

    branch (
        name: Branch To URL Identified By Item
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 44
            }
        }
        serverSideCondition {
            type: item=value
            item: P0_HOME
            value: 44
        }
    )

    branch (
        name: Go To Page 44
        execution {
            sequence: 100
            point: afterSubmit
        }
        behavior {
            target: {
                page: 44
            }
        }
        serverSideCondition {
            type: item=value
            item: P0_HOME
            value: 44
        }
    )

)

