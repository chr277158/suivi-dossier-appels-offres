    dynamicAction nouveau-2 (
        name: Nouveau
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P47_DATE_FIN
                P47_DATE_DEBUT
                P47_SOLDE_AVANT
                P47_NBR_FERIES
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function calculer() {
                        var debut = apex.item('P47_DATE_DEBUT').getValue();
                        var fin   = apex.item('P47_DATE_FIN').getValue();
                        
                        if (debut && fin) {
                            // Conversion des dates DD/MM/YYYY en objets Date pour le calcul
                            var d1 = new Date(debut.split('/').reverse().join('-'));
                            var d2 = new Date(fin.split('/').reverse().join('-'));
                            
                            // Différence brute : DATE_FIN (reprise) n'est pas comptée
                            var diff = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
                            
                            if (diff >= 0) {
                                var avant  = parseFloat(apex.item('P47_SOLDE_AVANT').getValue()) || 0;
                                var feries = parseInt(apex.item('P47_NBR_FERIES').getValue(), 10) || 0;
                                
                                // Jours réels à déduire (jours ouvrables de congé)
                                var joursADeduire = diff - feries;
                                if (joursADeduire < 0) joursADeduire = 0;
                    
                                // Mise à jour du champ Nombre de Jours sur la page
                                apex.item('P47_NBR_JOURS').setValue(diff);
                                
                                // Gestion propre du type de congé (Checkbox APEX)
                                var rawType = apex.item('P47_TYPE_CONGE').getValue();
                                var isSolde = false;
                                
                                if (Array.isArray(rawType)) {
                                    isSolde = rawType.includes('SOLDE');
                                } else if (typeof rawType === 'string') {
                                    isSolde = rawType.split(':').includes('SOLDE');
                                }
                                
                                if (isSolde) {
                                    var soldeApres = avant - joursADeduire;
                                    apex.item('P47_SOLDE_APRES').setValue(soldeApres.toFixed(1));
                                } else {
                                    apex.item('P47_SOLDE_APRES').setValue(avant.toFixed(1));
                                }
                            } else {
                                // Si la date de reprise est antérieure à la date de début
                                apex.item('P47_NBR_JOURS').setValue(0);
                                apex.item('P47_SOLDE_APRES').setValue(apex.item('P47_SOLDE_AVANT').getValue());
                            }
                        }
                    }
                    calculer();
                    ```
            }
            affectedElements {
                selectionType: items
                items: P47_NBR_JOURS
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P47_DATE_FIN
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @nouveau
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

