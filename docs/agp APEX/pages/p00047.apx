    dynamicAction nouveau (
        name: Nouveau
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P47_DATE_J
        }

        action native-refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @titre
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
