    process save-conge (
        name: SAVE_CONGE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_solde_avant   NUMBER;
                    v_nbr_jours     NUMBER;
                    v_nbr_feries    NUMBER;
                    v_solde_apres   NUMBER;
                BEGIN
                    -- Récupération directe des valeurs calculées par le JavaScript de la page
                    v_solde_avant := NVL(TO_NUMBER(:P47_SOLDE_AVANT), 0);
                    v_nbr_jours   := NVL(TO_NUMBER(:P47_NBR_JOURS), 0);
                    v_nbr_feries  := NVL(TO_NUMBER(:P47_NBR_FERIES), 0);
                    
                    -- Vérification de la Checkbox (gère le format APEX à délimiteur)
                    IF :P47_TYPE_CONGE LIKE '%SOLDE%' THEN
                        v_solde_apres := v_solde_avant - (v_nbr_jours - v_nbr_feries);
                    ELSE
                        v_solde_apres := v_solde_avant;
                    END IF;
                
                    -- Insertion dans l'historique
                    INSERT INTO T_CONGE (
                        MATRICULE, NOM_PRENOM, SERVICE, FONCTION, TYPE_CONGE,
                        NBR_JOURS, NBR_FERIES, DATE_DEBUT, DATE_FIN,
                        SOLDE_AVANT, SOLDE_APRES, ADRESSE_CONGE, TELEPHONE
                    ) VALUES (
                        :P47_MATRICULE, 
                        :P47_NOM_PRENOM, 
                        :P47_SERVICE, 
                        :P47_FONCTION, 
                        :P47_TYPE_CONGE,
                        v_nbr_jours, 
                        v_nbr_feries, 
                        TO_DATE(:P47_DATE_DEBUT, 'DD/MM/YYYY'), 
                        TO_DATE(:P47_DATE_FIN, 'DD/MM/YYYY'), -- Date de reprise stockée
                        v_solde_avant, 
                        v_solde_apres,
                        :P47_ADRESSE_CONGE, 
                        :P47_TELEPHONE
                    );
                
                    -- Mise à jour du solde de l'employé
                    UPDATE SOLDE_CONGE 
                    SET SOLDE = v_solde_apres
                    WHERE MATRICULE = :P47_MATRICULE;
                
                    COMMIT;
                    HTP.P('success');
                
                EXCEPTION
                    WHEN OTHERS THEN
                        ROLLBACK;
                        HTP.P('Erreur lors de la sauvegarde : ' || SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 35650807628869418
        }
    )

)

