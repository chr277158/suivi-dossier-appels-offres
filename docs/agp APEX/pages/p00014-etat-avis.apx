page 14 (
    name: Etat Avis
    alias: ETAT-AVIS
    title: Etat Avis
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region etat-avis (
        name: Etat Avis
        type: form
        source {
            location: localDatabase
            tableName: DEMANDE_CLARIFICATION
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P14_EFFECTUER (
        type: switch
        label {
            label: Effectuer ?
            alignment: left
        }
        layout {
            sequence: 40
            region: @etat-avis
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--preTextBlock
                margin-top-lg
            ]
            cssClasses: [
                fond
                size
                =
                36
            ]
        }
        source {
            formRegion: @etat-avis
            column: EFFECTUER
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_EFFECTUÉ_LE (
        type: datePicker
        label {
            label: Effectué Le
            alignment: left
        }
        layout {
            sequence: 50
            region: @etat-avis
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @etat-avis
            column: EFFECTUÉ_LE
            dataType: date
        }
    )

    pageItem P14_ENVOYER (
        type: switch
        label {
            label: Envoyer
            alignment: left
        }
        layout {
            sequence: 60
            region: @etat-avis
            slot: regionBody
            alignment: left
            column: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @etat-avis
            column: ENVOYER
            dataType: varchar2
        }
    )

    pageItem P14_ENVOYÉ_LE (
        type: datePicker
        label {
            label: Envoyé Le
            alignment: left
        }
        layout {
            sequence: 70
            region: @etat-avis
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @etat-avis
            column: ENVOYÉ_LE
            dataType: date
        }
    )

    pageItem P14_ID_AVIS (
        type: hidden
        layout {
            sequence: 20
            region: @etat-avis
            slot: regionBody
        }
        source {
            formRegion: @etat-avis
            column: ID_AVIS
            dataType: number
        }
    )

    pageItem P14_REF_AE (
        type: textField
        label {
            label: Ref Ae
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @etat-avis
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            formRegion: @etat-avis
            column: REF_AE
            dataType: varchar2
        }
    )

    pageItem P14_REMARQUES (
        type: textarea
        label {
            label: Remarques
            alignment: left
        }
        layout {
            sequence: 80
            region: @etat-avis
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @etat-avis
            column: REMARQUES
            dataType: varchar2
        }
    )

    pageItem P14_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @etat-avis
            slot: regionBody
        }
        source {
            formRegion: @etat-avis
            column: ROWID
            dataType: rowid
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P14_ROWID
        }
    )

    button save (
        buttonName: SAVE
        label: Appliquer les modifications
        layout {
            sequence: 30
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_ROWID
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P14_EFFECTUER
        }
        clientSideCondition {
            type: item=value
            item: P14_EFFECTUER
            value: Y
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P14_EFFECTUÉ_LE
            }
            execution {
                sequence: 50
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_ENVOYER
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_ENVOYÉ_LE
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_EFFECTUÉ_LE
            }
            execution {
                sequence: 40
                fireWhenEventResultIs: false
            }
        )

        action native-hide-4 (
            action: hide
            affectedElements {
                selectionType: region
                region: @boutons
            }
            execution {
                sequence: 60
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P14_EFFECTUÉ_LE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P14_EFFECTUÉ_LE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P14_EFFECTUÉ_LE
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_ENVOYÉ_LE
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_ENVOYER
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P14_ENVOYER
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: region
                region: @boutons
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P14_ENVOYER
        }
        clientSideCondition {
            type: item=value
            item: P14_ENVOYER
            value: Y
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P14_ENVOYÉ_LE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P14_ENVOYÉ_LE
            }
            execution {
                sequence: 10
            }
        )

    )

    process fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        type: closeDialog
        settings {
            itemsToReturn: [
                P14_ROWID
                REQUEST
            ]
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 20327098262406571458
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialiser-le-panneau-etat-avis (
        name: Initialiser le panneau Etat Avis
        type: formInitialization
        formRegion: @etat-avis
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 20327097482418571458
        }
    )

    process traiter-le-panneau-etat-avis (
        name: Traiter le panneau Etat Avis
        type: formAutoRowProcessing
        formRegion: @etat-avis
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20327097837070571458
        }
    )

)

