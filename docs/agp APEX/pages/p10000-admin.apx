    region connected (
        name: connected
        type: themeTemplateComponent/comments
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT COUNT(*) AS nb_utilisateurs
                FROM APEX_WORKSPACE_SESSIONS s
                WHERE s.WORKSPACE_ID = V('WORKSPACE_ID')
                  AND s.REMOTE_ADDR <> '0:0:0:0:0:0:0:1' and s.USER_NAME <> 'nobody'
                 
                ```
        }
        layout {
            sequence: 13
            slot: body
            column: 1
            columnSpan: 1
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            commentText: NB_UTILISATEURS
            userName: NB_UTILISATEURS
        }
        plugin-avatar {
            icon: fa-number-&NB_UTILISATEURS.
        }

        column NB_UTILISATEURS (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: NB_UTILISATEURS
                dataType: number
            }
        )

    )

