    dynamicAction new (
        name: New_1
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: refreshconnected();
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @connected-2
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction régénérer-l-état (
        name: Régénérer l'état
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @add-user
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @etat-sur-le-nombre-d-utilisateurs
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

