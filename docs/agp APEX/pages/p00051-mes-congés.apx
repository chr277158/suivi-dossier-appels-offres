                ]
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region nouveau (
        name: Nouveau
        type: staticContent
        layout {
            sequence: 13
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
    )

    region nouveau-2 (
        name: Nouveau
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @nouveau
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    button nouveau (
        buttonName: Nouveau
        label: Nouveau congé
        layout {
            sequence: 10
            region: @nouveau-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 47
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction nouveau (
        name: Nouveau
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @nouveau
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @mes-congés
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process mes-congés-enregistrer-les-données-de-grille-interactive (
        name: Mes Congés - Enregistrer les données de grille interactive
        type: interactiveGridAutoRowProcessing
        editableRegion: @mes-congés
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 36549357763195644
        }
    )

)

