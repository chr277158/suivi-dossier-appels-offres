page 51 (
    name: Mes Congés
    alias: MES-CONGÉS
    title: Mes Congés
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chemin-de-navigation (
        name: Chemin de navigation
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mes-congés (
        name: Mes Congés
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: T_CONGE
            whereClause: matricule = :P0_MAT
        }
        layout {
            sequence: 23
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 36547473549195625
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }
            flashback {
                minutesAgo: 5
            }

            displayColumn (
                column: @CONGE_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @MATRICULE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @NOM_PRENOM
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @SERVICE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @FONCTION
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TYPE_CONGE
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @NBR_JOURS
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @NBR_FERIES
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @DATE_DEBUT
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @DATE_FIN
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @SOLDE_AVANT
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @SOLDE_APRES
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @ADRESSE_CONGE
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @TELEPHONE
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @DATE_DEMANDE
                layout {
                    sequence: 16
                }
            )

            displayColumn (
                column: @STATUT
                layout {
                    show: false
                    sequence: 17
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @Impression
                layout {
                    sequence: 18
                }
            )

        )

        column ADRESSE_CONGE (
            type: textField
            heading {
                heading: Adresse Conge
            }
            layout {
                sequence: 150
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: ADRESSE_CONGE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CONGE_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CONGE_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column DATE_DEBUT (
            type: datePicker
            heading {
                heading: Date Debut
            }
            layout {
                sequence: 110
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DATE_DEBUT
                dataType: date
            }
        )

        column DATE_DEMANDE (
            type: datePicker
            heading {
                heading: Date Demande
            }
            layout {
                sequence: 170
            }
