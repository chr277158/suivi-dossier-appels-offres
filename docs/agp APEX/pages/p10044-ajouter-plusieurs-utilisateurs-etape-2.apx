            parentRegion: @conteneur-d-assistant
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from apex_collections
                 where collection_name = 'ACL_BULK_USER_VALID'
                ```
        }
        settings {
            features: advancedFormatting
            textFormatting: <span class="fa fa-check-circle u-success-text" aria-hidden="true"></span> <span style="line-height:36px;text-transform:lowercase;">&USERNAME!HTML.</span>
        }
        reportLayout {
            numberOfRows: 10000
        }
    )

    pageItem P10044_INVALID_COUNT (
        type: hidden
        layout {
            sequence: 30
            region: @eléments-masqués
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(*)
                  from apex_collections
                 where collection_name = 'ACL_BULK_USER_VALID'
                ```
        }
        security {
            sessionStateProtection: restricted
        }
    )

    pageItem P10044_ROLE (
        type: hidden
        layout {
            sequence: 10
            region: @eléments-masqués
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select LISTAGG( role_name, ', ')
                         WITHIN GROUP (ORDER BY role_name) role_name
                from APEX_APPL_ACL_ROLES
                where application_id = :APP_ID
                and instr(:P10043_ROLE, role_id, 1) > 0
                ```
        }
        security {
            sessionStateProtection: restricted
        }
    )

    pageItem P10044_VALID_COUNT (
        type: hidden
        layout {
            sequence: 20
            region: @eléments-masqués
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(*)
                  from apex_collections
                 where collection_name = 'ACL_BULK_USER_VALID'
                ```
        }
        security {
            sessionStateProtection: restricted
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button previous (
        buttonName: PREVIOUS
        label: Précédent
        layout {
            sequence: 10
            region: @boutons
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:history.back();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Ajouter des utilisateurs
        layout {
            sequence: 20
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from apex_collections
                 where collection_name = 'ACL_BULK_USER_VALID'
                ```
        }
    )

    process ajouter-des-utilisateurs-à-la-liste-de-contrôle-d-accès (
        name: Ajouter des utilisateurs à la liste de contrôle d'accès
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_user_role_ids apex_application_global.vc_arr2;
                begin
                    for c in (  select distinct c001 as username, c003 as user_roles
                                from   apex_collections
                                where  collection_name = 'ACL_BULK_USER_VALID' )
                    loop
                         l_user_role_ids := apex_util.string_to_table(c.user_roles);
                         for i in 1..l_user_role_ids.count loop
                             apex_acl.add_user_role(p_application_id => :APP_ID, p_user_name => c.username, p_role_id => l_user_role_ids(i));
                         end loop;
                    end loop;
                
                    apex_collection.delete_collection('ACL_BULK_USER_INVALID');
                    apex_collection.delete_collection('ACL_BULK_USER_VALID');
                    :P10043_PRELIM_USERS := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Utilisateurs ajoutés.
        }
        advanced {
            executionMappingIdentifier: 61391681565289275497
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 61391681951361275498
        }
    )

)

