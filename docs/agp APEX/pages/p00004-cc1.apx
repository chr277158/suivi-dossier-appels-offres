    )

    region rem (
        name: rem
        title: "ملاحظات "
        type: staticContent
        layout {
            sequence: 190
            parentRegion: @dates
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region statut (
        name: Statut
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @appel-d-offfres
            slot: regionBody
            rowCssClasses: [
                u-color-21-bg
                u-color-21-text
            ]
            columnCssClasses: [
                u-color-20-bg
                u-color-21-text
            ]
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                u-color-22-bg
                u-color-0-text
            ]
        }
    )

    region تحيين-المعطيات (
        name: " تحيين المعطيات"
        title: " "
        type: form
        source {
            location: localDatabase
            tableName: SP
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
