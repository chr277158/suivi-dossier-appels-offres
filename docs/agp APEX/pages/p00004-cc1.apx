    dynamicAction activation-modif-admin-zone (
        name: activation_modif_admin_zone1
        execution {
            sequence: 140
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @معلومات-أساسية-عن-الصفقة
        }
        clientSideCondition {
            type: itemIsInList
            item: P0_MAT
            list: [
                91591
                92491
            ]
        }

        action activation (
            name: activation
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P4_BUDGET
                    P4_DÉTAIL_DE_RÉPONSE
                    P4_NATURE_DE_DEPENSE
                    P4_OBJET_CCT
                    نوعية الطلب
                    P4_طريقة_ابرام_الصفقة
                    اللجنة المختصة
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P4_BUDGET
                    P4_DÉTAIL_DE_RÉPONSE
                    P4_NATURE_DE_DEPENSE
                    P4_OBJET_CCT
                    نوعية الطلب
                    P4_طريقة_ابرام_الصفقة
                    اللجنة المختصة
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction affiche-rem (
        name: affiche REM
        execution {
            sequence: 4
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P4_NEW_2
            value: 0
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @voir-rem
            }
            execution {
                sequence: 6
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P4_REM
            }
            execution {
                sequence: 8
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @voir-rem
            }
            execution {
                sequence: 9
                fireWhenEventResultIs: false
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P4_REM
            }
            execution {
                sequence: 7
            }
        )

    )

