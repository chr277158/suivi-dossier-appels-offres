page 4 (
    name: Cc
    alias: CC1
    title: Cc
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#jquery.maskedinput.min.js
        executeWhenPageLoads:
            ```javascript-browser
            $("#P4_REF_AO").mask("A#.##.#.####");
            //$("#P4_BUDGET").mask("## ###.###,###")
            //$("#P4_BUDGET").mask("FML999G999G999G999G990D00");
            ```
    }
    css {
        inline:
            ```css
            @media print {
                /* 1. Masquer toute la barre de boutons du bas (Annuler, Imprimer, etc.) */
                .t-Dialog-footer, .t-ButtonRegion {
                    display: none !important;
                }
            
                /* 2. (Sécurité) Masquer spécifiquement les boutons par leur classe générique APEX */
                button.t-Button, .t-Button {
                    display: none !important;
                }
                
                /* 3. Masquer les éléments de navigation et de debug */
                .t-Header, .t-Footer, .apex-debug-bar, .t-Body-nav {
                    display: none !important;
                }
            
                /* 4. Afficher le titre personnalisé */
                body::before {
                    content: attr(data-page-title);
                    display: block;
                    text-align: center;
                    font-size: 24pt;
                    font-weight: bold;
                    margin-bottom: 20px;
                    padding-bottom: 10px;
                    border-bottom: 1px solid #ccc;
                    width: 100%;
                }
                
                /* 5. Réinitialiser les marges et l'affichage pour l'impression */
                body, .t-Dialog-page {
                    background: white !important;
                    margin: 0 !important;
                    overflow: visible !important;
                }
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region appel-d-offfres (
        name: "APPEL D’OFFFRES "
        type: form
        source {
            location: localDatabase
            tableName: CC
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        accessibility {
            useLandmark: false
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region dates (
        name: Dates
        type: staticContent
        layout {
            sequence: 70
            parentRegion: @appel-d-offfres
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region fichiers-de-lancement (
        name: Fichiers de lancement
        type: form
        source {
            location: localDatabase
            tableName: FICHIER_LNCEMENT
        }
        layout {
            sequence: 120
            parentRegion: @معلومات-أساسية-عن-الصفقة
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        accessibility {
            useLandmark: false
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region new (
        name: New
        title: Demande de clarification des prestataires
        type: staticContent
        layout {
            sequence: 180
            parentRegion: @تحيين-المعطيات
            slot: regionBody
        }
        appearance {
            template: @/standard
