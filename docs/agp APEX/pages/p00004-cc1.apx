    dynamicAction date-lancement-statut (
        name: date lancement statut
        execution {
            sequence: 280
        }
        when {
            selectionType: items
            items: P4_DATE_OUVERTURE_DES_PLIS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     
                    
                      -- Règle 2 : DATE_OUVERTURE_DES_PLIS  
                      IF :P4_DATE_OUVERTURE_DES_PLIS IS NOT NULL 
                         AND TO_DATE(:P4_DATE_OUVERTURE_DES_PLIS, 'DD-MM-YYYY') < SYSDATE
                         AND :P4_STATUS < 3
                      THEN
                        :P4_STATUS := 3;
                      END IF;
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

