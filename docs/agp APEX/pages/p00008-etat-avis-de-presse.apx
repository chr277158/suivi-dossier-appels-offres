page 8 (
    name: etat avis de presse
    alias: ETAT-AVIS-DE-PRESSE
    title: Ajout Demandes de renseignements  &P8_REF_AE.
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region test (
        name: TEST
        type: form
        source {
            location: localDatabase
            tableName: DEMANDE_CLARIFICATION
        }
        layout {
            sequence: 20
            slot: contentBody
            columnSpan: 5
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P8_EFFECTUER (
        type: switch
        label {
            label: "Réception "
            alignment: left
        }
        layout {
            sequence: 30
            region: @test
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @test
            column: EFFECTUER
            dataType: varchar2
        }
    )

    pageItem P8_EFFECTUÉ_LE (
        type: datePicker
        label {
            label: Reçu Le
            alignment: left
        }
        layout {
            sequence: 40
            region: @test
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @test
            column: EFFECTUÉ_LE
            dataType: date
        }
    )

    pageItem P8_ENVOYER (
        type: switch
        label {
            label: Réponce
            alignment: left
        }
        layout {
            sequence: 50
            region: @test
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @test
            column: ENVOYER
            dataType: varchar2
        }
    )

    pageItem P8_ENVOYÉ_LE (
        type: datePicker
        label {
            label: Envoyé Le
            alignment: left
        }
        layout {
            sequence: 60
            region: @test
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @test
            column: ENVOYÉ_LE
            dataType: date
        }
    )

    pageItem P8_ID_AVIS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @test
            slot: regionBody
        }
        source {
            formRegion: @test
            column: ID_AVIS
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P8_REF_AE (
        type: displayOnly
        label {
            label: Ref Dossier
            alignment: left
        }
        layout {
            sequence: 20
            region: @test
            slot: regionBody
            alignment: left
            column: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @test
            column: REF_AE
            dataType: varchar2
        }
    )

    pageItem P8_REMARQUES (
        type: textarea
        label {
            label: Objet du Demande de renseignements supplémentaires
            alignment: left
        }
        settings {
            autoHeight: true
            charCounter: true
        }
        layout {
            sequence: 70
            region: @test
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @test
            column: REMARQUES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @boutons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-clipboard-new
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P8_ID_AVIS
        }
    )

    button save (
        buttonName: SAVE
        label: Appliquer les modifications
        layout {
            sequence: 30
            region: @boutons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_ID_AVIS
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P8_EFFECTUÉ_LE
        }

        action native-set-value (
            action: setValue
            settings {
                value: Y
            }
            affectedElements {
                selectionType: items
                items: P8_EFFECTUER
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P8_ENVOYÉ_LE
        }

        action native-set-value (
            action: setValue
            settings {
                value: Y
            }
            affectedElements {
                selectionType: items
                items: P8_ENVOYER
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 18466263375986212520
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialiser-le-panneau-etat-avis-de-presse (
        name: Initialiser le panneau etat avis de presse
        type: formInitialization
        formRegion: @test
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22178898267333402870
        }
    )

    process traiter-le-panneau-etat-affichage-public (
        name: Traiter le panneau Etat Affichage Public
        type: formAutoRowProcessing
        formRegion: @test
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 25862758455913083195
        }
    )

)

