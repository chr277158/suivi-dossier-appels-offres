page 10030 (
    name: Tableau de bord des activités
    alias: TABLEAU-DE-BORD-DES-ACTIVITÉS
    title: Tableau de bord des activités
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @droits-d-administration
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @fonctionnalité-génération-d-états-d-activité
    }

    region dernière-activité (
        name: Dernière activité
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select userid_lc       as username,
                       max(time_stamp) as last_activity
                  from apex_activity_log
                 where flow_id     = :app_id
                   and time_stamp >= sysdate - ( 1/24/60/60 * :P10030_TIMEFRAME )
                   and userid_lc  is not null
                 group by userid_lc
                 order by 2 desc
                
                ```
            pageItemsToSubmit: P10030_TIMEFRAME
        }
        layout {
            sequence: 50
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h240
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Aucune activité n'a été trouvée
        }

        column LAST_ACTIVITY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Last Activity
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column USERNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Username
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

    )

    region erreurs-récentes (
        name: Erreurs récentes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sqlerrm    label,
                       time_stamp value
                  from apex_activity_log
                 where flow_id    = :app_id
                   and time_stamp >= sysdate - ( 1/24/60/60 * :P10030_TIMEFRAME )
                   and sqlerrm    is not null
                 order by 2 desc, 1
                ```
            pageItemsToSubmit: P10030_TIMEFRAME
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h240
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Aucune donnée n'a été trouvée.
        }

        column LABEL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Libellé
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column VALUE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Valeur
                alignment: center
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: SINCE
            }
            sorting {
                sortable: false
            }
        )

    )

    region evénements-de-la-page-horaire (
        name: Evénements de la page Horaire
        type: chart
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        settings {
            timeAxisType: enabled
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series série (
            name: Série 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    with nw as (
                        -- APEX_ACTIVITY_LOG uses dates; convert system time to local time zone.
                        select from_tz( cast( sysdate as timestamp ), to_char( systimestamp, 'TZR' ) ) at local as tm from dual
                    ),
                    window as (
                        select
                             trunc(nw.tm - ((level-1)/24),'HH') start_tm,
                             trunc(nw.tm - ((level-2)/24),'HH') end_tm,
                             trunc(sysdate-((level-1)/24),'HH') log_start_tm,
                             trunc(sysdate-((level-2)/24),'HH') log_end_tm
                        from nw
                        connect by level <= round( 24 * ( 1/24/60/60 * nvl(:P10030_TIMEFRAME,1) ) )
                    )
                    select w.start_tm log_time,
                           ( select count(*)
                               from apex_activity_log l
                              where l.flow_id = :app_id
                                and l.time_stamp between w.log_start_tm and w.log_end_tm ) as value
                    from window w
                    order by 1
                    ```
                pageItemsToSubmit: P10030_TIMEFRAME
            }
            columnMapping {
                label: LOG_TIME
                value: VALUE
            }
            performance {
                maxRowsToProcess: 350
            }
        )

        axis x (
            name: x
            value {
                format: datetimeShort
            }
            minorTicks {
                show: true
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            majorTicks {
                show: auto
            }
        )

    )

    region filtres (
        name: Filtres
        type: staticContent
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noUI
                t-Form--large
            ]
        }
    )

    region pages-les-plus-actives (
        name: Pages les plus actives
        type: chart
        layout {
            sequence: 30
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series série (
            name: Série 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select x.step_id||'. '||(select page_name from apex_application_pages p where p.application_id = :app_id and page_id = x.step_id) label, 
                            value
                    from ( select step_id,
                                  count(*) as value
                             from apex_activity_log
                            where flow_id = :app_id
                              and time_stamp >= sysdate - ( 1/24/60/60 * :P10030_TIMEFRAME )
                              and step_id is not null
                            group by step_id
                            order by 2 desc
                         ) x
                    ```
                pageItemsToSubmit: P10030_TIMEFRAME
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            performance {
                maxRowsToProcess: 10
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            majorTicks {
                show: auto
            }
        )

    )

    region principaux-utilisateurs (
        name: Principaux utilisateurs
        type: chart
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h320
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            orientation: horizontal
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series série (
            name: Série 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl( userid_lc, apex_lang.message('APEX.FEATURE.TOP_USERS.USERNAME.NOT_IDENTIFIED') ) as label,
                           count(*) as value
                    from apex_activity_log
                    where flow_id = :app_id
                    and time_stamp >= sysdate - ( 1/24/60/60 * :P10030_TIMEFRAME )
                    group by nvl( userid_lc, apex_lang.message('APEX.FEATURE.TOP_USERS.USERNAME.NOT_IDENTIFIED') )
                    order by 2 desc
                    ```
                pageItemsToSubmit: P10030_TIMEFRAME
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            performance {
                maxRowsToProcess: 10
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            majorTicks {
                show: auto
            }
        )

    )

    pageItem P10030_TIMEFRAME (
        type: selectList
        label {
            label: Tranche de temps
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @timeframe-4-weeks
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtres
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: staticValue
            staticValue: 900
        }
        default {
            type: static
            staticValue: 900
        }
    )

    button view-activity-by-user (
        buttonName: VIEW_ACTIVITY_BY_USER
        label: Voir les détails
        layout {
            sequence: 10
            region: @evénements-de-la-page-horaire
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-angle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10031
                clearCache: 10031
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button view-activity-by-user-2 (
        buttonName: VIEW_ACTIVITY_BY_USER
        label: Voir les détails
        layout {
            sequence: 10
            region: @principaux-utilisateurs
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-angle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10031
                clearCache: 10031
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button view-activity-details (
        buttonName: VIEW_ACTIVITY_DETAILS
        label: Voir les détails
        layout {
            sequence: 10
            region: @pages-les-plus-actives
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-angle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10034
                clearCache: 10034
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button view-recent-errors (
        buttonName: VIEW_RECENT_ERRORS
        label: Voir les détails
        layout {
            sequence: 10
            region: @erreurs-récentes
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-angle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10032
                clearCache: 10032
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction modifier-les-filtres (
        name: Modifier les filtres
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P10030_TIMEFRAME
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @evénements-de-la-page-horaire
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @principaux-utilisateurs
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pages-les-plus-actives
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @erreurs-récentes
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-5 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dernière-activité
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

)

