    computation p36-etat (
        itemName: P36_ETAT
        execution {
            sequence: 10
        }
        computation {
            type: sqlQueryMultipleValues
            sqlQuery:
                ```sql
                select 
                    
                   
                   
                    CASE
                      WHEN DATE_FIN_DU_MARCHÉ IS NOT NULL 
                         AND DATE_FIN_DU_MARCHÉ < SYSDATE
                    THEN 'Clôturé'   
                     WHEN DATE_DE_MISE_VIGUEUR <=  SYSDATE
                         AND (DATE_FIN_DU_MARCHÉ IS NULL 
                              OR DATE_FIN_DU_MARCHÉ <= SYSDATE)
                               THEN 'En exécution'
                    WHEN DATE_GARANTIE_FINALE IS NOT NULL THEN 'Cautionnement Définitif reçue'
                    WHEN DATE_RETOUR_ENREGISTRE IS NOT NULL THEN 'Contrat enregistré'
                    WHEN DATE_ENVOI_CLIENT_ENREGISTREMENT IS NOT NULL THEN 'Enregistrement en cours'
                    WHEN DATE_RETOUR_ADMIN_SIGNE IS NOT NULL THEN 'Signé par administration'
                    WHEN DATE_ENVOI_ADMIN_SIGNATURE IS NOT NULL THEN 'En attente signature administration'
                    WHEN DATE_RETOUR_CLIENT_SIGNE IS NOT NULL THEN 'Signé par titulaire'
                    WHEN DATE_ENVOI_CLIENT_SIGNATURE IS NOT NULL THEN 'En attente signature titulaire'
                    WHEN DATE_AVIS_JURIDIQUE IS NOT NULL THEN 'Avis juridique reçu'
                    WHEN DATE_LIVRAISON_JURIDIQUE IS NOT NULL THEN 'En cours avis juridique'
                
                   
                    
                    ELSE 'Nouveau / Non traité'
                END AS etat_contrat
                 
                
                
                
                   
                 from CONTRATS CONTRATS 
                ```
        }
    )

