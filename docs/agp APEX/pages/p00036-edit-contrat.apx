    pageItem P36_DEVISE (
        type: popupLov
        label {
            label: Devise
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    CASE code
                        WHEN 'USD' THEN '💵 Dollar (USD)'
                        WHEN 'EUR' THEN '💶 Euro (EUR)'
                        WHEN 'TND' THEN '🇹🇳 Dinar (TND)'
                        ELSE '💰 Autre'
                    END as display_value,
                    code as return_value
                FROM (
                    SELECT 'USD' as code FROM dual UNION ALL
                    SELECT 'EUR' FROM dual UNION ALL
                    SELECT 'TND' FROM dual UNION ALL
                    SELECT 'OTHER' FROM dual
                )
                ```
        }
        layout {
            sequence: 100
            region: @edit-contrat
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @edit-contrat
            column: DEVISE
            dataType: varchar2
        }
    )

