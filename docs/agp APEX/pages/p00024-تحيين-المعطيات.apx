    pageItem P24_NEW (
        type: hidden
        layout {
            sequence: 120
            region: @fichiers-de-lancement
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT ID_AVIS FROM 
                DEMANDE_CLARIFICATION WHERE REF_AE=:P24_NB
                ```
            used: always
        }
    )

    pageItem P24_NEW_1 (
        type: hidden
        layout {
            sequence: 130
            region: @fichiers-de-lancement
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: SELECT ID_REM FROM REMARQUE  WHERE REF_DOS=:P24_NB
            used: always
        }
    )

