page 24 (
    name: تحيين المعطيات
    alias: تحيين-المعطيات
    title: "تحيين معطيات الصفقة  عدد &P24_NB. "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    headerAndFooter {
        headerText: " &P24_NB. "
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fichiers-de-lancement (
        name: Fichiers de lancement
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @تحيين-المعطيات
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region تحيين-المعطيات (
        name: " تحيين المعطيات"
        title: " "
        type: form
        source {
            location: localDatabase
            tableName: SP
        }
        layout {
            sequence: 10
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P24_ACCORD_DG (
        type: hidden
        layout {
            sequence: 40
            region: @fichiers-de-lancement
            slot: regionBody
        }
    )

