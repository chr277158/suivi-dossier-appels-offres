    region enregistrements-maître (
        name: Enregistrements maître
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT
                    "ANNEE",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P41_ANNE', p_values => "ANNEE") LINK,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P41_ANNE,'0') = "ANNEE"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    "ANNEE" LIST_TITLE, -- Puisque c'est groupé, on affiche juste l'année
                    null LIST_TEXT,     -- On met NULL ici car on ne peut pas afficher un texte spécifique si plusieurs lignes sont combinées
                    null LIST_BADGE
                from "PREVIS_ANNUEL" x
                where (:P41_SEARCH is null
                        or upper(x."ANNEE") like '%'||upper(:P41_SEARCH)||'%'
                      )
                order by "ANNEE"
                ```
            pageItemsToSubmit: P41_SEARCH
        }
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Aucune donnée n'a été trouvée.</div>
        }

