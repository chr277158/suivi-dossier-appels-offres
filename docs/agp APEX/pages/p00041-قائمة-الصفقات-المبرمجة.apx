    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* 1) Donne une hauteur plus grande à la zone header (optionnel) */
            .myClass .a-GV-header{
              height: 100px;         /* Ajuste selon ton besoin */
              line-height: 50px;     /* Optionnel: vertical align/centrage */
              padding: 5px;
              white-space: normal;   /* Autorise le retour à la ligne */
              overflow-wrap: break-word;
              word-wrap: break-word;
            }
            
            /* 2) Force le texte du libellé à se wrapper */
            .myClass .a-GV-header .a-GV-headerLabel{
              white-space: normal;
              overflow-wrap: break-word;
              word-wrap: break-word;
              height: auto;
              line-height: 1.2;      /* Plus naturel pour du multi-ligne */
              padding: 5px;
            }
            /* Appliquer RTL uniquement sur la vue Monoligne (Single Row View) */
            .a-RV {
                direction: rtl;
                text-align: right;
            }
            
            /* Aligner le contenu des champs et les libellés */
            .a-RV .u-Form-labelContainer,
            .a-RV .u-Form-inputContainer,
            .a-RV-fieldValue,
            .a-RV-readonly {
                direction: rtl;
                text-align: right;
            }
            
            /* Inverser l'icône des groupes extensibles pour le RTL */
            .a-RV .a-Collapsible-icon {
                margin-left: 8px; /* Espace à gauche au lieu de droite */
                margin-right: 0;
            }
            
            /* Toolbar spécifique quand on est en mode édition monoligne */
            .a-IG-toolbar {
                /* Si vous voulez que la toolbar reste RTL même en mode grille, gardez ceci. 
                   Sinon, on peut la rendre conditionnelle via JS si nécessaire. */
                direction: rtl;
            }
            /* 2 colonnes pour la Single Row View */
            .u-Form {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr  ;
                gap: 10px;
            }
            
            .a-RV .u-Form-inputContainer {
                align-items: baseline;
                background-color: #dddde6;
            }
            
            /* Style général */
            .a-IG-recordView {
                background-color: #f0f4ff;
            }
            
            .u-Form-label {
                font-size: 13px !important;
                font-weight: bold;
            
            }
            
            .apex-item-text,
            .apex-item-select,
            .apex-item-textarea {
                font-size: 13px !important;
                font-weight: bold;
                border-radius: 10px !important;
            }
            
            
            ```
    }
