page 10033 (
    name: Performances de page
    alias: PERFORMANCES-DE-PAGE
    title: Performances de page
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @droits-d-administration
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Cette page fournit un état interactif des performances et de la popularité de la page. L'état est trié par <strong>Performances pondérées</strong> qui sont calculées en multipliant le temps écoulé médian et le nombre de vues de page.</p>
            <p>Sélectionnez la tranche de temps de génération d'état (par défaut = 1 jour) en haut de la page si nécessaire.<br>
            Pour trier et filtrer les données, cliquez sur les en-têtes de colonne, ou cliquez sur le bouton <strong>Actions</strong> pour personnaliser l'affichage des colonnes et de nombreuses fonctionnalités avancées supplémentaires. Pour rétablir les paramètres par défaut de l'état interactif, cliquez sur le bouton <strong>Réinitialiser</strong>.</p>
            ```
    }
    config {
        buildOption: @fonctionnalité-génération-d-états-d-activité
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--noUI
                t-Form--large
            ]
        }
    )

    region performances-de-page (
        name: Performances de page
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select step_id page,
                    (   select page_name
                        from apex_application_pages p
                        where p.page_id = l.step_id
                            and p.application_id = :app_id ) page_name,
                    median(elap)                   median_elapsed,
                    count(*) * median(elap)        weighted_performance,
                    sum(decode(sqlerrm,null,0,1))  errors,
                    count(distinct userid)         distinct_users,
                    count(distinct session_id)     application_sessions,
                    count(*)                       page_views,
                    max(elap)                      max_elapsed,
                    sum(nvl(num_rows,0))           total_rows,
                    sum(decode(page_mode,'P',1,0)) partial_page_views,
                    sum(decode(page_mode,'D',1,0)) full_page_views,
                    min(elap)                      min_elapsed,
                    avg(elap)                      avg_elapsed
                from apex_activity_log l
                where flow_id = :app_id
                    and time_stamp >= sysdate - ( 1/24/60/60 * :P10033_TIMEFRAME )
                    and userid is not null
                group by step_id
                ```
            pageItemsToSubmit: P10033_TIMEFRAME
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucune donnée n'a été trouvée.
            whenMoreDataFound: Le nombre maximal de lignes pour cet état est de #MAX_ROW_COUNT# lignes. Appliquez un filtre pour réduire le nombre d'enregistrements dans votre requête.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 48201957142493053377
        }

        column APPLICATION_SESSIONS (
            type: plainText
            heading {
                heading: Sessions d'application
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column AVG_ELAPSED (
            type: plainText
            heading {
                heading: Temps moyen écoulé
                alignment: end
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G990D9999
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column DISTINCT_USERS (
            type: plainText
            heading {
                heading: Utilisateurs distincts
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
