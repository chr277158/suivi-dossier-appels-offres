            }
            appearance {
                formatMask: 999G999G999G999G999G990D9999
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column MEDIAN_ELAPSED (
            type: plainText
            heading {
                heading: Temps médian écoulé
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
