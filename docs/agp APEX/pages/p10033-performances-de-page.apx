        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Performances de page
        }

        savedReport 482019676 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APPLICATION_SESSIONS (
                sequence: 7
            )

            displayColumn DISTINCT_USERS (
                sequence: 6
            )

            displayColumn ERRORS (
                sequence: 5
            )

            displayColumn MEDIAN_ELAPSED (
                sequence: 3
            )

            displayColumn PAGE (
                sequence: 1
            )

            displayColumn PAGE_NAME (
                sequence: 2
            )

            displayColumn PAGE_VIEWS (
                sequence: 8
            )

            displayColumn WEIGHTED_PERFORMANCE (
                sequence: 4
            )

            sort (
                column: WEIGHTED_PERFORMANCE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: PAGE_VIEWS
                sort {
                    direction: desc
                    sequence: 2
                }
            )

        )

    )

    pageItem P10033_TIMEFRAME (
        type: selectList
        label {
            label: Tranche de temps
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @timeframe-4-weeks
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @boutons
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: staticValue
            staticValue: 900
        }
        default {
            type: static
            staticValue: 900
        }
    )

    button reset-report (
        buttonName: RESET_REPORT
        label: Réinitialiser
        layout {
            sequence: 20
            region: @performances-de-page
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: t-Button--iconLeft
            icon: fa-undo-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction régénérer-l-état (
        name: Régénérer l'état
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P10033_TIMEFRAME
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @performances-de-page
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

