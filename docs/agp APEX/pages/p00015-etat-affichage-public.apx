page 15 (
    name: Etat Affichage Public
    alias: ETAT-AFFICHAGE-PUBLIC
    title: Etat Affichage Public
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region etat-affichage-public (
        name: Etat Affichage Public
        type: form
        source {
            location: localDatabase
            tableName: DEMANDE_CLARIFICATION
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: contentBody
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region page_plug (
        name: "  ."
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P15_EFFECTUER (
        type: switch
        label {
            label: Effectuer
            alignment: left
        }
        layout {
            sequence: 40
            region: @etat-affichage-public
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @etat-affichage-public
            column: EFFECTUER
            dataType: varchar2
        }
    )

    pageItem P15_EFFECTUÉ_LE (
        type: datePicker
        label {
            label: Effectué Le
            alignment: left
        }
        layout {
            sequence: 50
            region: @etat-affichage-public
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @etat-affichage-public
            column: EFFECTUÉ_LE
            dataType: date
        }
    )

    pageItem P15_ENVOYER (
        type: switch
        label {
            label: Envoyer
            alignment: left
        }
        layout {
            sequence: 60
            region: @etat-affichage-public
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @etat-affichage-public
            column: ENVOYER
            dataType: varchar2
        }
    )

    pageItem P15_ENVOYÉ_LE (
        type: datePicker
        label {
            label: Envoyé Le
            alignment: left
        }
        layout {
            sequence: 70
            region: @etat-affichage-public
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @etat-affichage-public
            column: ENVOYÉ_LE
            dataType: date
        }
    )

    pageItem P15_ID_AVIS (
        type: hidden
        layout {
            sequence: 20
            region: @etat-affichage-public
            slot: regionBody
        }
        source {
            formRegion: @etat-affichage-public
            column: ID_AVIS
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P15_NEW (
        type: displayImage
        label {
            alignment: left
        }
        settings {
            basedOn: url
        }
        layout {
            sequence: 10
            region: @page_plug
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: height="200"
        }
        source {
            type: staticValue
            staticValue: #APP_FILES#icons/app-icon-512.png
        }
    )

    pageItem P15_REF_AE (
        type: displayOnly
        label {
            label: Ref Ae
            alignment: left
        }
        layout {
            sequence: 30
            region: @etat-affichage-public
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @etat-affichage-public
            column: REF_AE
            dataType: varchar2
        }
    )

    pageItem P15_REMARQUES (
        type: textarea
        label {
            label: Remarques
            alignment: left
        }
        layout {
            sequence: 90
            region: @etat-affichage-public
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @etat-affichage-public
            column: REMARQUES
            dataType: varchar2
        }
    )

    pageItem P15_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @etat-affichage-public
            slot: regionBody
        }
        source {
            formRegion: @etat-affichage-public
            column: ROWID
            dataType: rowid
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P15_ID_AVIS
        }
    )

    button save (
        buttonName: SAVE
        label: Appliquer les modifications
        layout {
            sequence: 30
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P15_ID_AVIS
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P15_EFFECTUER
            value: Y
        }

        action native-set-value (
            action: setValue
            settings {
                value: trfd
            }
            affectedElements {
                selectionType: items
                items: P15_EFFECTUER
            }
            execution {
                sequence: 10
            }
        )

    )

    process fermer-la-boîte-de-dialogue (
        name: Fermer la boîte de dialogue
        type: closeDialog
        settings {
            itemsToReturn: REQUEST
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 20327119963182571642
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialiser-le-panneau-etat-affichage-public (
        name: Initialiser le panneau Etat Affichage Public
        type: formInitialization
        formRegion: @etat-affichage-public
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 20327119114855571642
        }
    )

    process traiter-le-panneau-etat-affichage-public (
        name: Traiter le panneau Etat Affichage Public
        type: formAutoRowProcessing
        formRegion: @etat-affichage-public
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20327119593408571642
        }
    )

)

