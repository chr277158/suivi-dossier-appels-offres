page 52 (
    name: Congé
    alias: CONGÉ
    title: Congé
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function saveAndPrint() {
               
                printRegion('formulaire-a4');
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region nouveau (
        name: Nouveau
        type: form
        source {
            location: localDatabase
            tableName: T_CONGE
        }
        layout {
            sequence: 43
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region titre (
        name: TITRE
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                  * { box-sizing: border-box; margin: 0; padding: 0; }
                  body { font-family: "Times New Roman", serif; background: #f0f0f0; }
                  .a4 {
                    width: 210mm;
                    min-height: 297mm;
                    padding: 15mm;
                    margin: 10mm auto;
                    background: #fff;
                    border: 3px double #000;
                    direction: rtl;
                  }
                  .header {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    margin-bottom: 8mm;
                  }
                  .header-date { text-align: right; font-size: 13pt; font-weight: bold; min-width: 120px; direction: ltr;}
                  .header-org  { text-align: left; font-size: 13pt; font-weight: bold; line-height: 1.5; }
                  .titre {
                    text-align: center;
                    font-size: 22pt;
                    font-style: italic;
                    text-decoration: underline;
                    font-weight: bold;
                    margin-bottom: 6mm;
                  }
                  .checkboxes {
                    display: flex;
                    justify-content: space-around;
                    direction: rtl;
                    font-size: 12pt;
                    font-weight: bold;
                    /*border: 1px solid #000;*/
                    padding: 4pt 6pt;
                    margin-bottom: 5mm;
                  }
                  .checkboxes span { white-space: nowrap; }
                  .main-table {
                    width: 800px;
                    align:center;
                    border-collapse: collapse;
                    font-size: 13pt;
                    font-weight: bold;
                    direction: rtl;
                  }
                  .main-table td { padding: 12pt 14pt; vertical-align: middle; }
                  .lbl { text-align: right; white-space: nowrap; width: 25%; }
                  .val { text-align: right;  min-width: 120px; }
                   .val2 { text-align: right;  min-width: 120px;  direction: ltr; }
                  .sep { width: 30mm; }
                  .footer-sign {
                    margin-top: 20mm;
                    display: flex;
                    justify-content: space-between;
                    direction: rtl;
                    font-size: 13pt;
                    font-weight: bold;
                  }
                  .print-btn {
                    margin: 15px auto;
                    display: block;
                    padding: 10px 25px;
                    background: #007BFF;
                    color: #fff;
                    border: none;
                    cursor: pointer;
                    font-size: 15px;
                    border-radius: 5px;
                  }
                  @media print {
                    body { background: #fff; }
                    .print-btn { display: none; }
                    .a4 { margin: 0; border: 3px double #000; }
                  }
                </style>
                
                <script>
                function printRegion(regionId) {
                  var content = document.getElementById(regionId).innerHTML;
                  var printWindow = window.open('', '', 'height=900,width=700');
                  printWindow.document.write(
                    '<html><head><title>طباعة</title>' +
                    '<style>' +
                    '* { box-sizing:border-box; margin:0; padding:0; }' +
                    'body { font-family:"Times New Roman",serif; direction:rtl; }' +
                    '.a4 { width:210mm; min-height:297mm; padding:15mm; border:3px double #000; }' +
                    '.header { display:flex; justify-content:space-between; margin-bottom:8mm; }' +
                    '.header-org { text-align:right; font-size:13pt; font-weight:bold; line-height:1.5; }' +
                    '.header-date { text-align:right; font-size:13pt; font-weight:bold; }' +
                    '.titre { text-align:center; font-size:22pt; font-style:italic; text-decoration:underline; font-weight:bold; margin-bottom:6mm; }' +
                    '.checkboxes { display:flex; justify-content:space-around; direction:rtl; font-size:12pt; font-weight:bold;  padding:4pt 6pt; margin-bottom:5mm; }' +
                    '.main-table { width:170mm; align:center; border-collapse:collapse; font-size:13pt; font-weight:bold; direction:rtl; }' +
                    '.main-table td { padding:12pt 14pt; vertical-align:middle; }' +
                    '.lbl { text-align:right; white-space:nowrap; width:20%; }' +
                    '.val { text-align:right;  min-width:120px; }' +
                    '.val2 { text-align:right;  min-width:120px; direction: ltr; }' +
                    '.sep { width:20mm; }' +
                    '.footer-sign { margin-top:20mm; display:flex; justify-content:space-between; direction:rtl; font-size:13pt; font-weight:bold; }' +
                    '</style>' +
                    '</head><body><div class="a4">' + content + '</div></body></html>'
                  );
                  printWindow.document.close();
                  printWindow.print();
                }
                
                </script>
                
                <div id="formulaire-a4" class="a4">
                
                  <!-- EN-TÊT -->
                  <div class="header">
                    <div class="header-org">
                      <div>المجمع الكيميائي التونسي</div>
                      <div>الإدارة الجهوية للمعامل بقابس</div>
                    </div>
                    <div class="header-date">
                      <div style="font-size:13pt; font-weight:bold;">
                        قابس في : <span data-field="date">...</span>
                      </div>
                    </div>
                  </div>
                
                  <div class="checkboxes"></div>
                  <div class="checkboxes"></div>
                
                  <!-- TITRE -->
                  <div class="titre">مطلب إجازة</div>
                
                  <div class="checkboxes"></div>
                  <div class="checkboxes"></div>
                
                  <!-- CASES À COCHER -->
                  <div class="checkboxes">
                    <span><span data-field="type1">☐</span> &nbsp; خالصة الأجر</span>
                    <span><span data-field="type2">☐</span> &nbsp; غير خالصة الأجر</span>
                    <span><span data-field="type3">☐</span> &nbsp; لأسباب عائلية</span>
                    <span><span data-field="type4">☐</span> &nbsp; مرخص فيها</span>
                    <span><span data-field="type5">☐</span> &nbsp; تعويض</span>
                    </div>
                
                  <div class="checkboxes"></div>
                  <div class="checkboxes"></div>
                
                  <!-- TABLEAU PRINCIPAL -->
                  <table class="main-table">
                    <tr>
                      <td class="lbl">الاسم و اللقب :</td>
                      <td class="val"><span data-field="user">...</span></td>
                      <td class="sep"></td>
                      <td class="lbl">الرقم الآلي :</td>
                      <td class="val"><span data-field="mat">...</span></td>
                    </tr>
                    <tr>
                      <td class="lbl">المصلحة :</td>
                      <td class="val" colspan="2"><span data-field="service">...</span></td>
                      <td class="lbl">المهنة :</td>
                      <td class="val"><span data-field="fonction">...</span></td>
                    </tr>
                    <tr>
                      <td class="lbl">عدد الأيام المطلوبة :</td>
                      <td class="val"><span data-field="nbr_jours">...</span></td>
                      <td class="sep"></td>
                      <td class="lbl" colspan="2">من ضمنها : ( <span data-field="nbr_feries">0</span> يوم) أعياد رسمية</td>
                    </tr>
                    <tr>
                      <td class="lbl">تاريخ بداية الإجازة :</td>
                      <td class="val2"><span data-field="date_debut">...</span></td>
                      <td class="sep"></td>
                      <td class="lbl">تاريخ الرجوع :</td>
                      <td class="val2"><span data-field="date_fin">...</span></td>
                    </tr>
                    <tr>
                      <td class="lbl">الرصيد السابق :</td>
                      <td class="val"><span data-field="solde_avant">...</span></td>
                      <td class="sep"></td>
                      <td class="lbl">الرصيد الحالى :</td>
                      <td class="val"><span data-field="solde_apres">...</span></td>
                    </tr>
                    <tr>
                      <td class="lbl"colspan="2">العنوان أثناء الإجازة :<span data-field="adresse">...</span> قابس</td>
                      
                      <td class="sep"></td>
                      <td class="lbl">رقم الهاتف :</td>
                      <td class="val2" ><span data-field="tel">...</span></td>
                    </tr>
                  </table>
                
                  <!-- SIGNATURES -->
                  <div class="footer-sign">
                    <span>إمضاء المعني بالأمر</span>
                    <span>إمضاء رئيس المصلحة</span>
                  </div>
                
                </div>
                
                <button type="button"
                        class="print-btn"
                        onclick="saveAndPrint()">
                    🖨️ طباعة
                </button>
                ```
        }
        layout {
            sequence: 53
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: formulairea4
            regionDisplaySelector: true
        }
    )

    pageItem P52_ADRESSE_CONGE (
