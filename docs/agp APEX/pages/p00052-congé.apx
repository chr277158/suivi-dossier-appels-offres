    pageItem P52_TYPE_CONGE (
        type: checkboxGroup
        label {
            label: Type Conge
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: staticValues
            staticValues: STATIC2:خالصة الأجر;SOLDE,غیر خالصة الأجر;NON_SOLDE,لأسباب عائلیة;FAMILIAL,مرخص فیھا;AUTORISE,تعویض;COMPENSATION
            displayExtraValues: false
        }
        layout {
            sequence: 80
            region: @nouveau
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
