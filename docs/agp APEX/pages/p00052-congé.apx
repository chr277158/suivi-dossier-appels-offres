    dynamicAction nouveau (
        name: Nouveau
        execution {
            sequence: 31
        }
        when {
            event: load
            selectionType: region
            region: @nouveau
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @nouveau
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction nouveau-2 (
        name: Nouveau_3
        execution {
            sequence: 21
        }
        when {
            selectionType: region
            region: @nouveau
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    function majTitre() {
                        var t = $('#formulaire-a4');
                        
                        // Récupération sécurisée des valeurs simples
                        t.find('[data-field="date"]').text(apex.item('P52_DATE_DEMANDE').getValue() || '...');
                        t.find('[data-field="user"]').text(apex.item('P0_USER').getValue() || '...');
                        t.find('[data-field="mat"]').text(apex.item('P0_MAT').getValue() || '...');
                        t.find('[data-field="service"]').text(apex.item('P52_SERVICE').getValue() || '...');
                        t.find('[data-field="fonction"]').text(apex.item('P52_FONCTION').getValue() || '...');
                        t.find('[data-field="nbr_jours"]').text(apex.item('P52_NBR_JOURS').getValue() || '...');
                        t.find('[data-field="nbr_feries"]').text(apex.item('P52_NBR_FERIES').getValue() || '0');
                        t.find('[data-field="date_debut"]').text(apex.item('P52_DATE_DEBUT').getValue() || '...');
                        t.find('[data-field="date_fin"]').text(apex.item('P52_DATE_FIN').getValue() || '...');
                        t.find('[data-field="solde_avant"]').text(apex.item('P52_SOLDE_AVANT').getValue() || '...');
                        t.find('[data-field="solde_apres"]').text(apex.item('P52_SOLDE_APRES').getValue() || '...');
                        t.find('[data-field="adresse"]').text(apex.item('P52_ADRESSE_CONGE').getValue() || '...');
                        t.find('[data-field="tel"]').text(apex.item('P52_TELEPHONE').getValue() || '...');
                    
                        // RÉPARATION DU PROBLÈME DE TYPE_CONGE
                        var rawType = apex.item('P52_TYPE_CONGE').getValue();
                        var values = [];
                    
                        // On s'assure que values soit toujours un tableau, peu importe ce qu'APEX renvoie
                        if (Array.isArray(rawType)) {
                            values = rawType;
                        } else if (typeof rawType === 'string' && rawType !== "") {
                            values = rawType.split(':'); // Séparateur défini dans votre export
                        }
                    
                        if (t.length > 0) {
                            // Utilisation de .indexOf pour la compatibilité ou .includes
                            t.find('[data-field="type1"]').html(values.indexOf('SOLDE')        !== -1 ? '☑' : '☐');
                            t.find('[data-field="type2"]').html(values.indexOf('NON_SOLDE')    !== -1 ? '☑' : '☐');
                            t.find('[data-field="type3"]').html(values.indexOf('FAMILIAL')     !== -1 ? '☑' : '☐');
                            t.find('[data-field="type4"]').html(values.indexOf('AUTORISE')     !== -1 ? '☑' : '☐');
                            t.find('[data-field="type5"]').html(values.indexOf('COMPENSATION') !== -1 ? '☑' : '☐');
                        }
                    }
                    
                    majTitre();
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process initialiser-le-panneau-heur (
        name: Initialiser le panneau heur
        type: formInitialization
        formRegion: @nouveau
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 36425425941628626
        }
    )

)

