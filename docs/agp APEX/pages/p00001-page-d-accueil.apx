page 1 (
    name: Page d'accueil
    alias: PAGE-D-ACCUEIL
    title: Page d'accueil
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // 1. طلب الإذن لتنبيهات الـ Windows
            function requestNotificationPermission() {
                if ('Notification' in window &&
                    Notification.permission !== 'granted' &&
                    Notification.permission !== 'denied') {
                    Notification.requestPermission();
                }
            }
            
            // 2. تنبيهات مستمرة حتى انتهاء الموعد (تعمل عند النداء)
            function checkAndDisplayReminders() {
                apex.server.process('GET_PENDING_REMINDERS', {
                    x01: 'Check'
                }, {
                    dataType: "json",
                    success: function (pData) {
                        if (pData && pData.items && pData.items.length > 0) {
                            pData.items.forEach(function (item) {
                                var title = item.NOTE_TITLE;
                                var details = item.NOTE_DETAILS;
                                var importance = item.IMPORTANCE_LEVEL;
            
                                if (importance == 3) {
                                    // 🔴 مهم جداً: Native Notification
                                    if (Notification.permission === "granted") {
                                        new Notification("🚨 تذكير مستمر: " + title, {
                                            body: details + "\n(سيستمر حتى الموعد النهائي)",
                                            icon: "data:image/svg+xml;utf8,",
                                            badge: "data:image/svg+xml;utf8,"
                                        });
                                    }
                                } else if (importance == 2) {
                                    // 🟠 مهم: Popup
                                    apex.message.showPageSuccess("🔔 تذكير مستمر: " + title + "<br>" + details);
                                } else if (importance == 1) {
                                    // 🔵 عادي: إشعار خفيف
                                    apex.message.clearErrors();
                                    apex.message.showPageSuccess("📝 " + title);
                                }
                            });
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error("خطأ في جلب التنبيهات:", textStatus);
                    }
                });
            }
            
            // 3. تطبيق النسبة المئوية على شريط التقدم داخل الـ Badge
            function applyProgressWidth() {
                document.querySelectorAll('#reminders_cards .a-CardView-badge').forEach(function (badge) {
                    var text = badge.innerText || badge.textContent;
                    // مثال نص: "15 دقيقة (40%)" أو "🔄 تذكير مستمر (70%)"
                    var match = text.match(/\((\d+)%\)/);
                    if (match && match[1]) {
                        var percent = match[1];
                        badge.style.setProperty('--progress-width', percent + '%');
                    }
                });
            }
            
            // 4. تحديث كروت التذكير + الشريط
            function refreshRemindersCards() {
                try {
                    var reg = apex.region('reminders_cards');
                    if (reg) {
                        reg.refresh();
                        // بعد أن ينتهي الـ refresh نطبّق النسبة على البادجات
                        setTimeout(applyProgressWidth, 500);
                    }
                } catch (e) {
                    console.error('Refresh error:', e);
                }
            }
            
            // 5. تشغيل كل شيء عند تحميل الصفحة
            requestNotificationPermission();
            checkAndDisplayReminders();   // فحص فوري أول مرة
            refreshRemindersCards();      // تحديث الكروت أول مرة
            
            // تنبيهات + تحديث كروت كل 30 ثانية
            setInterval(function () {
                checkAndDisplayReminders();
                refreshRemindersCards();
            }, 30000); // 30000 ms = 30 ثانية
            
            ```
    }
    css {
        inline:
            ```css
            .a-CardView-badge {
                background: linear-gradient(90deg, #f7fafc, #edf2f7) !important;
                border-radius: 20px !important;
                padding: 6px 12px !important;
                border: 2px solid #e2e8f0 !important;
                margin-top: 12px !important;
                font-weight: 600 !important;
                font-size: 0.9rem !important;
                position: relative !important;
                overflow: hidden !important;
            }
            
            .a-CardView-badge::before {
                content: '';
                position: absolute;
                top: 0; left: 0; bottom: 0;
                width: calc(var(--progress-width, 0%) - 8px);
                /* لون أخضر شفاف بدل تدرّج قوي */
                background: rgba(72, 187, 120, 0.25);  /* 0.25 = شفافية 25% */
                border-radius: 16px;
                transition: width 1s ease;
                z-index: 1;
            }
            .u-color-9 .a-CardView-badge::before  { background: rgba(245, 101, 101, 0.25); }  /* أحمر شفاف */
            .u-color-37 .a-CardView-badge::before { background: rgba(250, 191, 137, 0.25); }  /* برتقالي شفاف */
            .u-color-1 .a-CardView-badge::before  { background: rgba(99, 179, 237, 0.25); }   /* أزرق شفاف */
            
            
            /* ألوان الأهمية */
            .u-color-9 .a-CardView-badge::before  { background: linear-gradient(90deg, #f56565, #e53e3e); }
            .u-color-37 .a-CardView-badge::before { background: linear-gradient(90deg, #fabf89, #dd6b20); }
            .u-color-1 .a-CardView-badge::before  { background: linear-gradient(90deg, #63b3ed, #3182ce); }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region appels-d-offfres-en-cours (
        name: APPELS D’OFFFRES en Cours
        title: &ID_CC.
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       ID_CC,
                      
                       "Titre",
                        OBJET,
                       PROPOSITION_COMMISSION,
                       PC,
                       DATE_PROPOSITION,
                       CC_POUR_LANCEMENT,
                       CC,
                       DATE_CC,
                       CRITERES_EVALUATION,
                       CE,
                       DATE_CRITERES,
                       AVIS_DE_PRESSE,
                       AP,
                       DATE_AVIS,
                       DESIGNATION_DE_LA_COMMISSION,
                       DC,
                       DATE_DESIGNATION,
                       PROGRAM_LANC,
                       PL,
                       DATE_PROGRAM_LANC,
                       MAIL_PRESTATAIRE,
                       MP,
                       DATE_MAIL,
                       PROGRAMME_OUVERTURE_DE_PLIS,
                       POP,
                       DATE_PROGRAM_OUVERTURE,
                       NOTE_OUVERTURE_PLIS,
                       NOP,
                       DATE_NOTE_OP,
                       CAUTION_P,
                       STATUS,
                       ST,
                       STAT,
                       DATE_DE_LANC,
                       TEX,
                       DATE_OUVERTURE_DES_PLIS,
                       IDS,
                       CRA,
                       CRA2,
                       JOURS,
                       PROGRESS_COLOR,
                       BODY_HTML,
                       "linkh",
                       CP,
                       "المكلف_بالملف"
                 
                FROM FICHIER_MANQUANT_PAR_DOSSIER
                WHERE (
                    -- Cas 1 : Utilisateur standard (ne voit que ses dossiers)
                    (UPPER(v('P1_ROLE')) NOT IN ('ADMINISTRATOR', 'CONTRIBUTOR') 
                     AND "المكلف_بالملف" = v('P0_USER'))
                    
                    OR
                    
                    -- Cas 2 : Admin/Contributeur
                    (UPPER(v('P1_ROLE')) IN ('ADMINISTRATOR', 'CONTRIBUTOR') 
                     AND (
                         :P1_FILTER_USER IS NULL -- Option "Tous les dossiers"
                         OR 
                         "المكلف_بالملف" = :P1_FILTER_USER -- Option filtre spécifique
                     ))
                )
                ```
        }
        layout {
            sequence: 10
            parentRegion: @appels-d-offfres-en-cours-2
            slot: subRegions
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleA
            ]
        }
        componentAppearance {
            gridColumns: 3
        }
        title {
            column: "Titre"
        }
        subtitle {
            advancedFormatting: true
            htmlExpression: &TEX. &DATE_DE_LANC.
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <style>
                    /* ... ( bloc de style CSS inchangé) ... */
                    .div-1 {
                        background-color:  #777799;
                    }
                    .div-2 {
                       background-color:  rgb(228,249,153); 
                    }
                    .div-3 {
                        background-color: rgb(120,120,0);
                        font-family: verdana;
                        font-size: 150%;
                    }
                    .div-4 {
                        background-color:  #FFBE53;
                    }
                
                progress {
                  width: 300px;
                  height: 25px;
                  -webkit-appearance: none;
                  appearance: none;
                }
                
                /* Fond de la barre */
                progress::-webkit-progress-bar {
                  background-color: #eee;
                  border-radius: 2px;
                }
                
                /* STYLE COMMUN POUR L'EFFET RAYÉ */
                .progress-style::-webkit-progress-value {
                  border-radius: 2px;
                  background-size: 35px 25px, 100% 100%, 100% 100%;
                  background-image: 
                    -webkit-linear-gradient(-45deg, transparent 33%, rgba(0, 0, 0, .1) 33%, rgba(0, 0, 0, .1) 66%, transparent 66%),
                    -webkit-linear-gradient(top, rgba(255, 255, 255, .25), rgba(0, 0, 0, .25));
                }
                
                /* ÉTAT BLEU (Valeur < 75) */
                progress.blue::-webkit-progress-value {
                  background-color: #09c; /* Couleur de base bleue */
                  background-image: 
                    -webkit-linear-gradient(-45deg, transparent 33%, rgba(0, 0, 0, .1) 33%, rgba(0, 0, 0, .1) 66%, transparent 66%),
                    -webkit-linear-gradient(top, rgba(255, 255, 255, .25), rgba(0, 0, 0, .25)),
                    -webkit-linear-gradient(left, #09c, #09c);
                }
                
                /* ÉTAT ROUGE (Valeur >= 75) */
                progress.red::-webkit-progress-value {
                  background-color: #f44; /* Couleur de base rouge */
                  background-image: 
                    -webkit-linear-gradient(-45deg, transparent 33%, rgba(0, 0, 0, .1) 33%, rgba(0, 0, 0, .1) 66%, transparent 66%),
                    -webkit-linear-gradient(top, rgba(255, 255, 255, .25), rgba(0, 0, 0, .25)),
                    -webkit-linear-gradient(left, #f44, #f44);
                }
                /* Texte centré */
                .progress-value {
                  position: absolute;
                  top: 0;
                  left: 0;
                  width: 100%;
                  height: 100%;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-weight: bold;
                  color: white; /* couleur du texte */
                }
                
                /* COMPATIBILITÉ FIREFOX */
                progress.blue::-moz-progress-bar { background-color: #09c; }
                progress.red::-moz-progress-bar { background-color: #f44; }
                 
                
                </style>
                {IF CRA2/}
                <table>
                    <tr class="div-3" style="height:40px"><td> Fichiers manquant : </td></tr>
                     <tr class="div-2"><td> &CC.</td></tr>
                    
                    <tr class="div-2"><td> &MP. </td></tr>
                    <tr class="div-2"><td> &NOP. </td></tr>
                    <tr class="div-2"><td> &CP.  </td></tr>
                    <tr class="div-4"><td> &ST. </td></tr>
                     <tr class="div-4"><td> &STAT. </td></tr>
                     
                </table>
                
                
                {ELSE/}
                 <table>
                    <tr class="div-3" style="height:40px"><td> Fichiers manquant : </td></tr>
                    <tr class="div-2"><td> &PC. </td></tr>
                    <tr class="div-2"><td> &CC.</td></tr>
                    <tr class="div-2"><td> &CE.</td></tr>
                    <tr class="div-2"><td> &AP.</td></tr>
                    <tr class="div-2"><td> &DC. </td></tr>
                    
                    <tr class="div-2"><td> &MP. </td></tr>
                    <tr class="div-2"><td> &POP.</td></tr>
                    <tr class="div-2"><td> &NOP. </td></tr>
                    <tr class="div-2"><td> &CP. </td></tr>
                    <tr class="div-4"><td> &ST. </td></tr>
                   <tr class="div-4"><td> &STAT. </td></tr>
                </table> 
                &CRA2.
                {ENDIF/}
                
                
                ```
        }
        secondaryBody {
            column: CRA
        }
        performance {
            lazyLoading: true
        }

        action action (
            label: Modifer
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 40
                    items: {
                        P40_ID: &ID_CC.
                        P40_ID_1: &ID_CC.
                        P40_ID_2: &ID.
                    }
                    clearCache: 40
                }
            }
            appearance {
                displayType: icon
                icon: fa-edit
                hot: true
            }
            serverSideCondition {
                type: expression
                plsqlExpression:
                    ```plsql
                    -- NVL(:CRA, 'Y') = 'CRA'
                    :CRA = 'CRA'
                    ```
            }
        )

        action action-2 (
            label: Modifier
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 4
                    items: {
                        P4_ID: &ID_CC.
                        P4_ID_1: &ID_CC.
                        P4_ID_2: &ID.
                    }
                }
            }
            appearance {
                displayType: icon
                icon: fa-edit
                hot: true
            }
            serverSideCondition {
                type: expression
                plsqlExpression: :CRA != 'CRA'
            }
        )

        action action-3 (
            label: imprimer classement
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 53
                    items: {
                        P53_REF: &"Titre".
                        P53_OBJET: &OBJET.
                    }
                }
            }
            appearance {
                hot: true
            }
        )

        action action-4 (
            label: imprimer Progr. de Lancment
            layout {
                sequence: 40
            }
            behavior {
                target: {
                    page: 55
                    items: {
                        P55_REF: &ID_CC.
                    }
                }
            }
            appearance {
                hot: true
            }
        )

    )

