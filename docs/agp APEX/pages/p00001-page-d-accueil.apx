                hot: true
            }
        )

    )

    pageItem P1_FILTER_USER (
        type: selectList
        label {
            label: Filtrer pour Charger les dossiers
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct "المكلف_بالملف" as display_value, 
                       "المكلف_بالملف" as return_value
                from FICHIER_MANQUANT_PAR_DOSSIER
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Tous les dossiers -
        }
        layout {
            sequence: 10
            region: @appels-d-offfres-en-cours-2
            slot: sortOrder
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            cssClasses: u-color-3
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: NULL
        }
        serverSideCondition {
            type: expression
            plsqlExpression: UPPER(:P1_ROLE) IN ('ADMINISTRATOR', 'CONTRIBUTOR')
        }
    )

    pageItem P1_NB (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT
                    COUNT(*) AS NOMBRE_DE_LIGNES
                FROM
                    SP SP,
                    CC CC
                WHERE
                    ((SP.ID=CC.ID) AND 
                    -- On cherche les dates comprises entre aujourd'hui et dans 7 jours
                   (TRUNC(DATE_OUVERTURE_DES_PLIS) BETWEEN TRUNC(SYSDATE) AND TRUNC(SYSDATE) + 7)) and  (
                    -- Condition 1 : Si l'utilisateur connecté est ADMIN, on affiche tout
                    UPPER(v('APP_USER')) IN ('92491', '91591' ,'3259','915912', '80503') 
                    OR
                    -- Condition 2 : Sinon, on filtre sur le champ
                    "المكلف_بالملف" = v('P0_USER')
                )
                ```
        }
    )

    pageItem P1_ROLE (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

