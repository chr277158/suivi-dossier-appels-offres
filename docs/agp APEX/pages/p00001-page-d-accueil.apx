    region new (
        name: New
        title: الملفات الجاهزة لفتح العروض &P1_NB.
        type: themeTemplateComponent/comments
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    SP.ID as SPID,
                    CC.ID as CCID, 
                    "عدد" as REF_DOSSIER,
                    CC.OBJET_CCT as SUJET,
                    CC.DATE_OUVERTURE_DES_PLIS as DATE_OUVERTURE,
                    TRUNC(DATE_OUVERTURE_DES_PLIS) - TRUNC(SYSDATE) as JOURS_RESTANTS
                FROM SP SP,
                CC CC
                WHERE ((SP.ID=CC.ID) AND 
                    -- On cherche les dates comprises entre aujourd'hui et dans 7 jours
                   (TRUNC(DATE_OUVERTURE_DES_PLIS) BETWEEN TRUNC(SYSDATE) AND TRUNC(SYSDATE) + 7)) and  (
                    -- Condition 1 : Si l'utilisateur connecté est ADMIN, on affiche tout
                    UPPER(v('APP_USER')) IN ('92491', '91591' ,'3259','915912', '80503') 
                    OR
                    -- Condition 2 : Sinon, on filtre sur le champ
                    "المكلف_بالملف" = v('P0_USER')
                )
                
                ```
        }
        layout {
            sequence: 10
            slot: beforeNavigationBar
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @droits-de-lecteur
        }
        componentAppearance {
            display: report
        }
        settings {
            commentText: REF_DOSSIER
            userName: DATE_OUVERTURE
            attributes: تبقى لفتح العروض &JOURS_RESTANTS. يوم
            style: chatSpeechBubbles
        }
        plugin-avatar {
            icon: fa-sm fa-calendar-clock
        }
        messages {
            whenNoDataFound: لا توجد ملفات الجاهزة لفتح العروض
        }

        column CCID (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CCID
                dataType: number
            }
        )

        column DATE_OUVERTURE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DATE_OUVERTURE
                dataType: date
            }
        )

        column JOURS_RESTANTS (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: JOURS_RESTANTS
                dataType: number
            }
        )

        column REF_DOSSIER (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: REF_DOSSIER
                dataType: varchar2
            }
        )

        column SPID (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: SPID
                dataType: number
            }
        )

        column SUJET (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SUJET
                dataType: varchar2
            }
        )

        action détails (
            position: actions
            label: Détails
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 10
                    items: {
                        P10_ID: &CCID.
                        P10_REF: &REF_DOSSIER.
                    }
                }
            }
        )

    )

    region notes (
        name: Notes
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    cc.id,
                    cc.ref_ao,
                    cc.objet_cct,
                    cc.budget,
                    cc."DÉTAIL_DE_RÉPONSE",
                    cc.nature_de_depense,
                    cc."DATE_LIMITE_PROPOSÉE",
                    cc.date_de_lanc,
                    cc.pv_cct,
                    cc.programme_ouverture_de_plis,
                    cc.jours_rest,
                    cc.date_ouverture_des_plis,
                    cc.status,
                    case 
                    WHEN  sysdate - cc.date_ouverture_des_plis > = 30 THEN  'لقد مر  ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   يوما على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30 THEN 'لقد مر  ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   يوما على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود ( إن توفرت ) و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        WHEN sysdate - cc.date_ouverture_des_plis > 0 and  sysdate - cc.date_ouverture_des_plis < 20 THEN  'لقد مرت ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   أيام على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود ( إن توفرت ) و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        ELSE '🔴🔴🔴 🔴🔴🔴🔴وضع الملف غير عادي الرجاء التثبت'
                    
                   
                    end as stat,
                    CASE  
                        WHEN sysdate - cc.date_ouverture_des_plis > 30 THEN 'u-color-39'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30  THEN 'u-color-37'
                        WHEN sysdate - cc.date_ouverture_des_plis > 0 and  sysdate - cc.date_ouverture_des_plis < 20  THEN 'u-color-35'
                        ELSE 'u-color-44-contrast'
                    END AS COLOR_CELL,
                   CASE  
                        WHEN sysdate - cc.date_ouverture_des_plis > 30 THEN '🔴 عاجل جداً'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30  THEN '🟠 مهم'
                        WHEN sysdate - cc.date_ouverture_des_plis > 10 and  sysdate - cc.date_ouverture_des_plis < 20  THEN '🔵 عادي'
                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                    CASE
                        WHEN  sysdate - cc.date_ouverture_des_plis > 30 THEN 'fa-fire fa-1x fa-stop-circle fa-anim-horizontal-shake fa-lg'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30 THEN 'fa-alarm-snooze fa-anim-spin-step fam-information fam-is-warning fa-lg'
                        WHEN sysdate - cc.date_ouverture_des_plis > 10 and  sysdate - cc.date_ouverture_des_plis < 20 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                       CASE
                        WHEN sysdate - cc.date_ouverture_des_plis > 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                    cc.creer_par,
                    cc."DATE_CRÉATION",
                    cc.programme_de_lancement
                FROM cc
                WHERE cc.status = 5
                
                  AND NOT EXISTS (
                        SELECT 1
                        FROM contrats ct
                        WHERE ct.id_cc = cc.id
                  )
                
                
                /*
                SELECT
                    ID,
                    NOTE_TITLE   AS NOTETITLE,
                    NOTE_DETAILS AS NOTEDETAILS,
                    REMINDER_DATETIME,
                    TO_CHAR(REMINDER_DATETIME, 'DD Mon - HH24:MI') AS REMINDERFMT,
                
                    -- أيقونة ولون حسب الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'fa-bell text-danger'
                        WHEN 2 THEN 'fa-exclamation-triangle text-warning'
                        WHEN 1 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                
                    -- نص الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN '🔴 عاجل جداً'
                        WHEN 2 THEN '🟠 مهم'
                        WHEN 1 THEN '🔵 عادي'
                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                
                    -- نص الشريط: الدقائق + النسبة المئوية
                    CASE
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE
                             AND REMINDER_DATETIME >= SYSDATE - 0.1/24 THEN
                             '🔄 تذكير مستمر (' || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             ) || '%)'
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE THEN
                             '✅ انتهى (100%)'
                        ELSE
                             FLOOR(((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440)
                             || ' Minutes ('
                             || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             )
                             || '%) '
                    END AS MINUTES_LEFT,
                
                    -- نسبة التقدم (0-100) متاحة لو احتجتها لاحقاً
                    LEAST(100, GREATEST(0,
                        (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                              ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                    )) AS PROGRESS_PERCENT,
                
                    -- كلاس إضافي لو أردت تأثير خاص عند الاقتراب (اختياري)
                    CASE
                        WHEN ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440 <= 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                
                    -- لون شريط التقدم حسب الأهمية (لو استخدمته داخل CSS)
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'bg-danger'
                        WHEN 2 THEN 'bg-warning'
                        WHEN 1 THEN 'bg-info'
                        ELSE 'bg-secondary'
                    END AS PROGRESS_COLOR
                
                FROM USER_NOTES
                WHERE USER_ID = :P32_ROLE
                   AND NOT (IS_SENT = 'Y'
                           AND REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) < SYSDATE -1)
                ORDER BY IMPORTANCE_LEVEL DESC, REMINDER_DATETIME ASC;
                */
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-Form--stretchInputs
                t-Form--leftLabels
