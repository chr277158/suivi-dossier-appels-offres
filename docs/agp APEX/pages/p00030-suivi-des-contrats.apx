        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontSize: 14
        }
        columnHeadings {
            fontSize: 12
        }
    )

    pageItem P30_ID (
        type: hidden
        layout {
            sequence: 13
            slot: body
        }
    )

    pageItem P30_REF (
        type: hidden
        layout {
            sequence: 10
            region: @cc
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select "REF_AO" as REF from "CONTRATS"
                where  "ID" = :P30_ID
                ```
        }
    )

    pageItem P30_SEARCH (
        type: textField
        label {
            label: Rechercher
            alignment: left
        }
        settings {
            submitWhenEnterPressed: true
        }
        layout {
            sequence: 10
            region: @rechercher
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
                t-Form-fieldContainer--postTextBlock
            ]
            icon: fa-search
            width: 30
            valuePlaceholder: Rechercher...
        }
    )

    button edit (
        buttonName: EDIT
        label: طباعة  تلخيص معلومات الصفقة
        layout {
            sequence: 20
            region: @cc
            slot: EDIT
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                items: {
                    P10_ID: &P30_ID.
                    P10_REF: &P30_REF.
                }
                clearCache: 10
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: edit_master_btn
        }
        security {
            authorizationScheme: @droits-de-lecteur
        }
    )

    computation p30-ref (
        itemName: P30_REF
        execution {
            sequence: 10
        }
        computation {
            sqlQuery:
                ```sql
                select "REF_AO" as REF from "CONTRATS"
                where  "ID" = :P30_ID
                ```
        }
    )

    process suivi-des-contrats-enregistrer-les-données-de-grille-interactive (
        name: suivi des contrats - Enregistrer les données de grille interactive
        type: interactiveGridAutoRowProcessing
        editableRegion: @suivi-des-contrats
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24557830476422230
        }
    )

)

