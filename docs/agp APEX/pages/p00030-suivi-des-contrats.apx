    region cc (
        name: Cc
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "REF_AO",
                "ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P30_ID', p_values => "ID") LINK, 
                    apex_page.get_url(p_items => 'P30_REF', p_values => "REF_AO") LINK2,
                    null ICON_CLASS,
                    null LINK_ATTR,
                    null ICON_COLOR_CLASS,
                    case when coalesce(:P30_ID,'0') = "ID"
                      then 'is-active' 
                      else ' '
                    end LIST_CLASS,
                    (substr("N_CONTRAT_BC", 1, 50)||( case when length("N_CONTRAT_BC") > 50 then '...' else '' end )) LIST_TITLE,
                    (substr("REF_AO", 1, 50)||( case when length("REF_AO") > 50 then '...' else '' end )) LIST_TEXT,
                    null LIST_BADGE
                from "CONTRATS" x
                where ( upper(x."REF_AO") like '%'||upper(:P30_REF)||'%' ) -- "REF_AO" = :P30_REF
                order by "REF_AO"
                
                ```
        }
        layout {
            sequence: 33
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                u-colors
                t-CardsRegion--removeHeader js-removeLandmark
                t-CardsRegion--styleB
                t-Form--large
                t-Form--stretchInputs
                t-Region-orderBy--center
            ]
            cssClasses: [
                js-master-region
                js-detail-region
            ]
            renderComponents: belowContent
        }
        headerAndFooter {
            headerText: &REF_AO.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P30_ID
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                u-colors
                t-MediaList--horizontal
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

