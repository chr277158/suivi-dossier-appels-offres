    region enregistrements-maître (
        name: Enregistrements maître
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH summary AS (
                    SELECT 
                        MIN("ID") as ID,
                        "REF_AO",
                        -- On concatène les contrats ici
                        LISTAGG("N_CONTRAT_BC", ', ') WITHIN GROUP (ORDER BY "N_CONTRAT_BC") as TOUS_LES_CONTRATS,
                        COUNT(*) as NB_CONTRATS
                    FROM "CONTRATS"
                    GROUP BY "REF_AO"
                )
                SELECT 
                    ID,
                    NULL LINK_CLASS,
                    apex_page.get_url(p_items => 'P30_ID', p_values => ID) LINK,
                    NULL ICON_CLASS,
                    NULL LINK_ATTR,
                    NULL ICON_COLOR_CLASS,
                    CASE WHEN COALESCE(:P30_ID, '0') = TO_CHAR(ID) THEN 'is-active' ELSE ' ' END LIST_CLASS,
                    -- Titre : REF_AO avec tronquage si trop long
                    CASE WHEN LENGTH("REF_AO") > 50 THEN SUBSTR("REF_AO", 1, 50) || '...' ELSE "REF_AO" END LIST_TITLE,
                    -- Texte : Liste des contrats
                    CASE WHEN LENGTH(TOUS_LES_CONTRATS) > 100 THEN SUBSTR(TOUS_LES_CONTRATS, 1, 100) || '...' ELSE TOUS_LES_CONTRATS END LIST_TEXT,
                    NB_CONTRATS LIST_BADGE
                FROM summary
                WHERE (:P30_SEARCH IS NULL
                    OR UPPER("REF_AO") LIKE '%'||UPPER(:P30_SEARCH)||'%'
                    OR UPPER(TOUS_LES_CONTRATS) LIKE '%'||UPPER(:P30_SEARCH)||'%'
                )
                ORDER BY "REF_AO"
                ```
            pageItemsToSubmit: P30_SEARCH
        }
        layout {
            sequence: 40
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                t-Form--large
                t-Form--stretchInputs
            ]
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showIcons
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">Aucune donnée n'a été trouvée.</div>
        }

