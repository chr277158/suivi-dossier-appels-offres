page 26 (
    name: متابع التغيرات
    alias: متابع-التغيرات
    title: متابع التغيرات
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region متابع-التغيرات (
        name: متابع التغيرات
        type: classicReport
        source {
            location: localDatabase
            tableName: M
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: no data found
        }

        column ACTION_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Action Type
            }
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )

        column CHANGED_BY (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Changed By
            }
            layout {
                sequence: 80
            }
            sorting {
                defaultSequence: 1
            }
        )

        column CHANGED_DATE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Changed Date
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
        )

        column IDC (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Idc
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
        )

        column IDS (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Ids
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
        )

        column LOG_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 0
            }
        )

        column NEW_VALUE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: New Value
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column OLD_VALUE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Old Value
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column RECORD_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column REF_AO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Ref Ao
            }
            layout {
                sequence: 20
            }
        )

        column TABLE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Table Name
            }
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )

        column عدد (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: عدد
            }
            layout {
                sequence: 110
            }
        )

    )

)

