        column RESPONSABLE_DOS (
            type: popupLov
            heading {
                heading: Responsable Dos
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  distinct T_USER.NOM as display_value,
                    T_USER.NOM as return_value
                     from T_USER 
                    order by 1;
                    ```
            }
            layout {
                sequence: 390
            }
            validation {
                maxLength: 255
            }
            source {
                databaseColumn: RESPONSABLE_DOS
                dataType: varchar2
            }
            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue:
                    ```sql
                    select SP."المكلف_بالملف" as "المكلف_بالملف"
                     
                     from SP SP
                      where SP."عدد" = :P45_REF_AO
                    ```
            }
