    region تذكير (
        name: تذكير
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                h1 {color:orange;}
                p {color:blue;}
                </style>
                
                <body>
                
                <h1 style="text-align:center">الرجاء التثبت من جميع المعلومات قبل  التسجيل النهائي</h1>
                <p style="text-align:center">خاصة العدد الكامل للعقود </p>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--leftLabels
                t-Form--labelsAbove
            ]
        }
    )

    pageItem P45_ID_CC (
        type: hidden
        layout {
            sequence: 10
            region: @تذكير
            slot: regionBody
        }
    )

    pageItem P45_REF_AO (
        type: hidden
        layout {
            sequence: 10
            region: @تذكير
            slot: regionBody
        }
    )

    button exit (
        buttonName: exit
        label: " خروج"
        layout {
            sequence: 60
            region: @ajout-contrat
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
            requiresConfirmation: true
        }
        confirmation {
            message: هل تأكدت من صحة جميع المعلومات
            style: warning
        }
    )

    dynamicAction nouveau (
        name: Nouveau
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P45_NB_CONTRAT
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var nb = $v("P45_NB_CONTRAT"); 
                    var igRegion = apex.region("contrats_ig"); // ID statique de ta région IG 
                    var igWidget = igRegion.widget(); var igActions = igWidget.interactiveGrid("getActions");
                    
                    
                    for (var i = 0; i < nb; i++) {
                       igActions.invoke("row-add-row");  // ✅ action correcte
                    }
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction nouveau-2 (
        name: Nouveau_1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ajout-contrat
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ajout-contrat
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process ajout-contrat-enregistrer-les-données-de-grille-interactive (
        name: AJOUT CONTRAT - Enregistrer les données de grille interactive
        type: interactiveGridAutoRowProcessing
        editableRegion: @ajout-contrat
        execution {
