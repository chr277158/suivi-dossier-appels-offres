page 45 (
    name: AJOUT CONTRAT
    alias: AJOUT-CONTRAT
    title: AJOUT CONTRAT
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline: "  $(\"N_CONTRAT_BC\").mask(\"A*.##.#.####\");"
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ajout-contrat (
        name: AJOUT CONTRAT
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CONTRATS
            whereClause: ID_cc = :P45_ID_CC
