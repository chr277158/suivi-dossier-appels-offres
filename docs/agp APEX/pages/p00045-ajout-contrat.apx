        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: contrats_ig
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @droits-de-contribution
            update: @droits-de-contribution
            delete: @droits-de-contribution
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
            addButtonLabel: إضافة عقد جديد
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            authorization: @droits-de-contribution
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 23612471984674954
        }

