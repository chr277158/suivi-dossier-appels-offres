page 10061 (
    name: Aide
    alias: PAGE_HELP
    title: Aide
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @fonctionnalité-a-propos-de-la-page
    }

    region dialogue-de-recherche (
        name: Dialogue de recherche
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                for c1 in 
                (
                    select page_title, help_text 
                      from apex_application_pages
                     where page_id = :P10061_PAGE_ID 
                       and application_id = :APP_ID
                )
                loop
                    if c1.help_text is null then
                        sys.htp.p('Il n' ||'y a pas d' || 'aide pour cette page.');
                    else
                        if substr(c1.help_text, 1, 3) != '<p>' then
                            sys.htp.p('<p>');
                        end if;
                
                        sys.htp.p(apex_application.do_substitutions(c1.help_text));
                
                        if substr(trim(c1.help_text), -4) != '</p>' then
                            sys.htp.p('</p>');
                        end if;
                    end if;
                end loop;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10061_PAGE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @dialogue-de-recherche
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

)

