page 35 (
    name: Contrats
    alias: CONTRATS
    title: Contrats
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // On attend un court instant que le widget IG Single Row View soit rendu
            setTimeout(function() {
                $(".a-RV-body .a-Collapsible.is-expanded button").each(function() {
                    $(this).click();
                });
            }, 50);
            ```
    }
    css {
        inline:
            ```css
            /* 1) Donne une hauteur plus grande à la zone header (optionnel) */
            .myClass .a-GV-header{
              height: 60px;         /* Ajuste selon ton besoin */
              line-height: 50px;     /* Optionnel: vertical align/centrage */
              padding: 5px;
              white-space: normal;   /* Autorise le retour à la ligne */
              overflow-wrap: break-word;
              word-wrap: break-word;
            }
            
            /* 2) Force le texte du libellé à se wrapper */
            .myClass .a-GV-header .a-GV-headerLabel{
              white-space: normal;
              overflow-wrap: break-word;
              word-wrap: break-word;
              height: auto;
              line-height: 1.1;      /* Plus naturel pour du multi-ligne */
              padding: 5px;
            }
            
            
            
            
            /* 2 colonnes pour la Single Row View */
            .u-Form {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr 1fr ;
                gap: 10px;
            }
            
            .a-RV .u-Form-inputContainer {
                align-items: baseline;
                background-color: #dddde6;
            }
            
            /* Style général */
            .a-IG-recordView {
                background-color: #f0f4ff;
            }
            
            .u-Form-label {
                font-size: 13px !important;
                font-weight: bold;
            
            }
            
            .apex-item-text,
            .apex-item-select,
            .apex-item-textarea {
                font-size: 13px !important;
                font-weight: bold;
                border-radius: 10px !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chemin-de-navigation (
        name: Chemin de navigation
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region suivi-des-contrats-p46-new (
        name: suivi des contrats &P46_NEW.
        title: suivi des contrats &P46_NEW.
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: CONTRATS
        }
        layout {
            sequence: 30
            slot: body
            rowCssClasses: myClass
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: mregion
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        editAuthorization {
            update: @droits-de-contribution
            delete: @droits-de-contribution
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 66345069942847718
        }

