        column DEVISE (
            type: popupLov
            heading {
                heading: Devise
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                        CASE code
                            WHEN 'USD' THEN '💵 Dollar (USD)'
                            WHEN 'EUR' THEN '💶 Euro (EUR)'
                            WHEN 'TND' THEN '🇹🇳 Dinar (TND)'
                            ELSE '💰 Autre'
                        END as display_value,
                        code as return_value
                    FROM (
                        SELECT 'USD' as code FROM dual UNION ALL
                        SELECT 'EUR' FROM dual UNION ALL
                        SELECT 'TND' FROM dual UNION ALL
                        SELECT 'OTHER' FROM dual
                    )
                    ```
            }
            layout {
                sequence: 120
                group: @données-du-contrat
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DEVISE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
