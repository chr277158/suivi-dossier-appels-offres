            columnFormatting {
                htmlExpression:
                    ```html
                    <script>
                        var STATUS;
                        var C;
                        
                        if (STATUS = 1) {
                          C = "En Cours"
                        } else if (STATUS = 2) C = "Abouti"
                        else  {
                        C = "Infructueux"
                          ;
                        }
                        document.write(C)
                      </script>
                    ```
