    pageItem P10_ID (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
    )

    pageItem P10_REF (
        type: hidden
        layout {
            sequence: 20
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button btn-imprimer (
        buttonName: BTN_IMPRIMER
        label: Imprimer
        layout {
            sequence: 10
            region: @boutons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                t-Button--iconLeft
                t-Button--hoverIconPush
            ]
            cssClasses: print-hide
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        advanced {
            customAttributes: no-print
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            cssClasses: print-hide
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @btn-imprimer
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @boutons
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // 1. Récupère la valeur de l'item P10_REF (ou le titre de la page)
                    //var pageTitle = $v('P10_REF'); 
                    
                    // 2. Injecte cette valeur dans un attribut de la balise <body>
