page 2 (
    name: Etat - des Dossiers
    alias: ETAT-APPEL-D-OFFFRES
    title: Etat - Des Dossiers
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* 1) Donne une hauteur plus grande à la zone header (optionnel) */
            .myClass .a-GV-header{
              height: 60px;         /* Ajuste selon ton besoin */
              line-height: 50px;     /* Optionnel: vertical align/centrage */
              padding: 5px;
              white-space: normal;   /* Autorise le retour à la ligne */
              overflow-wrap: break-word;
              word-wrap: break-word;
            }
            
            /* 2) Force le texte du libellé à se wrapper */
            .myClass .a-GV-header .a-GV-headerLabel{
              white-space: normal;
              overflow-wrap: break-word;
              word-wrap: break-word;
              height: auto;
              line-height: 1.1;      /* Plus naturel pour du multi-ligne */
              padding: 5px;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            <p>Pour rechercher des données, entrez un terme de recherche dans la boîte de dialogue de recherche, ou cliquez sur les en-têtes de colonne pour limiter les enregistrements renvoyés.</p>
            
            <p>Vous pouvez exécuter de nombreuses fonctions en cliquant sur le bouton <strong>Actions</strong>. Ainsi, vous pouvez sélectionner les colonnes à afficher/masquer et leur séquence d'affichage, mais aussi de nombreuses fonctions relatives aux données et aux formats. Vous pouvez également définir des vues de données supplémentaires à l'aide des options Graphique, Grouper par et Permuter.</p>
            
            <p>Pour enregistrer vos personnalisations, sélectionnez l'état ou cliquez sur le bouton de téléchargement pour décharger les données. Entrez votre adresse électronique et l'intervalle de temps dans l'abonnement selon lequel envoyer les données régulièrement.<p>
            
            <p>Pour plus d'informations, cliquez sur Aide au bas du menu Actions.</p>
            
            <p>Pour rétablir les paramètres par défaut de l'état interactif, cliquez sur le bouton <strong>Réinitialiser</strong>.</p>
            ```
    }

    region chemin-de-navigation (
        name: Chemin de navigation
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select CC.ID as ID,
                    CC.REF_AO as REF_AO,
                    CC.OBJET_CCT as OBJET_CCT,
                    CC.BUDGET as BUDGET,
                    SP."طريقة_ابرام_الصفقة" as "طريقة_ابرام_الصفقة",
                    SP."نوعية_الطلب" as "نوعية_الطلب",
                    SP."اللجنة_المختصة" as "اللجنة_المختصة",
                    CC.NATURE_DE_DEPENSE as NATURE_DE_DEPENSE,
                    CC."DÉTAIL_DE_RÉPONSE" as "DÉTAIL_DE_RÉPONSE",
                    CC."DATE_CRÉATION" as "DATE_CRÉATION",
                    SP."تاريخ_تقديم_كراسات_الشروط_للمصادقة" as "تاريخ_تقديم_كراسات_الشروط_للمصادقة",
                    SP."تاريخ_مصادقة_اللجنة_على_كراسات_الشروط" as "تاريخ_مصادقة_اللجنة_على_كراسات_الشروط",
                    SP."التاريخ__للإعلان_عن_المنافسة" as "التاريخ__للإعلان_عن_المنافسة",
                    CC."DATE_LIMITE_PROPOSÉE" as "DATE_LIMITE_PROPOSÉE",
                    CC.DATE_OUVERTURE_DES_PLIS as DATE_OUVERTURE_DES_PLIS,
                    SP."تاريخ_قرار__لجنة_الصفقات" as "تاريخ_قرار__لجنة_الصفقات",
                    CC.STATUS as STATUS,
                    SP."تاريخ_ارجاع_الضمانات_الوقتية" as "تاريخ_ارجاع_الضمانات_الوقتية",
                    SP."المكلف_بالملف" as "المكلف_بالملف",
                     case when SP."اللجنة_المختصة" = 'CRA' then 40 else 4 end as P,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID_1' else 'P4_ID_1' end as VID1,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID_2' else 'P4_ID_2' end as VID2,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID' else 'P4_ID' end as VID,
                    fl.ID as FL_ID,
                    fl.ID_CC 
                 from FICHIER_LNCEMENT fl,
                    SP SP,
                    CC CC 
                 where (CC.ID=SP.ID
                    and CC.ID=fl.ID_CC)
                 and 
                 
                 
                
                 (
                    -- Condition 1 : Si l'utilisateur connecté est ADMIN, on affiche tout
                    (UPPER(v('P0_ROLE')) IN ('ADMINISTRATOR', 'CONTRIBUTOR') 
                    OR
                    -- Condition 2 : Sinon, on filtre sur le champ
                    "المكلف_بالملف" = v('P0_USER')
                ))
                AND  CC.STATUS <'5'
                ```
        }
        layout {
            sequence: 43
            slot: body
            columnCssClasses: myClass
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
            savePublicReportAuthorization: @droits-d-administration
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 33612607730079545
        }

