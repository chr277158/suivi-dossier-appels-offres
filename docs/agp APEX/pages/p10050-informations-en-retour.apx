page 10050 (
    name: Informations en retour
    alias: INFORMATIONS-EN-RETOUR
    title: Informations en retour
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 480
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .feedback-positive, .feedback-negative, .feedback-neutral { padding: 8px; border-radius: 100%; background-color: white; margin: 4px; }
            .feedback-positive { color: var(--ut-feedback-positive-text-color, var(--ut-palette-success)); }
            .feedback-neutral { color: var(--ut-feedback-neutral-text-color, var(--ut-palette-warning)); }
            .feedback-negative { color: var(--ut-feedback-negative-text-color, var(--ut-palette-danger)); }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    config {
        buildOption: @fonctionnalité-informations-en-retour
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region panneau-sur-informations-en-retour (
        name: Panneau sur Informations en retour
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
    )

    pageItem P10050_APPLICATION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @panneau-sur-informations-en-retour
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10050_FEEDBACK (
        type: textarea
        label {
            label: Informations en retour
            alignment: left
        }
        layout {
            sequence: 40
            region: @panneau-sur-informations-en-retour
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 64
            height: 4
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P10050_PAGE_ID (
        type: hidden
        layout {
            sequence: 20
            region: @panneau-sur-informations-en-retour
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10050_RATING (
        type: radioGroup
        label {
            label: Expérience
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: sharedComponent
            lov: @feedback-rating
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 35
            region: @panneau-sur-informations-en-retour
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        security {
            escapeSpecialChars: false
        }
    )

    pageItem P10050_USER_AGENT (
        type: hidden
        layout {
            sequence: 30
            region: @panneau-sur-informations-en-retour
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sys.owa_util.get_cgi_env('user-agent') x
                from dual
                ```
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @boutons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
            executeValidations: false
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button submit (
        buttonName: SUBMIT
        label: Soumettre les informations en retour
        layout {
            sequence: 10
            region: @boutons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--gapLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation au-moins-une-information-en-retour-doit-être-indiquée (
        name: Au moins une information en retour doit être indiquée
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                if :P10050_FEEDBACK is null and :P10050_RATING is null then
                    return false;
                else
                    return true;
                end if;
                ```
        }
        error {
            errorMessage: Fournissez des informations en retour sur votre expérience.
            displayLocation: inlineInNotification
        }
    )

    process soumettre-les-informations-en-retour (
        name: Soumettre les informations en retour
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                apex_util.submit_feedback (
                    p_comment              => :P10050_FEEDBACK,
                    p_application_id       => :APP_ID,
                    p_page_id              => :P10050_PAGE_ID,
                    p_rating               => :P10050_RATING
                    );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Informations en retour soumises
        }
        advanced {
            executionMappingIdentifier: 61391690424574275502
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10051
                action: resetPagination
                successMessage: false
            }
        }
    )

)

