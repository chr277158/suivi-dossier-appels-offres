page 31 (
    name: edit rem
    alias: EDIT-REM
    title: "Modifier la Remarque "
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region modifier-la-remarque (
        name: "Modifier la Remarque "
        title: "Modifier la Remarque "
        type: form
        source {
            location: localDatabase
            tableName: REMARQUE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P31_ID_CC (
        type: hidden
        layout {
            sequence: 20
            region: @modifier-la-remarque
            slot: regionBody
        }
        source {
            formRegion: @modifier-la-remarque
            column: ID_CC
            dataType: number
        }
    )

    pageItem P31_ID_REM (
        type: hidden
        layout {
            sequence: 10
            region: @modifier-la-remarque
            slot: regionBody
        }
        source {
            formRegion: @modifier-la-remarque
            column: ID_REM
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P31_REF_DOS (
        type: textField
        label {
            label: Ref Dos
            alignment: right
        }
        layout {
            sequence: 30
            region: @modifier-la-remarque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @modifier-la-remarque
            column: REF_DOS
            dataType: varchar2
        }
    )

    pageItem P31_REMARQUE (
        type: textarea
        label {
            label: Remarque
            alignment: right
        }
        layout {
            sequence: 40
            region: @modifier-la-remarque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @modifier-la-remarque
            column: REMARQUE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P31_ID_REM
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_ID_REM
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_ID_REM
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 17671198340372371
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-edit-rem (
        name: Initialize form edit rem
        type: formInitialization
        formRegion: @modifier-la-remarque
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 17670315639372371
        }
    )

    process process-form-edit-rem (
        name: Process form edit rem
        type: formAutoRowProcessing
        formRegion: @modifier-la-remarque
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 17670766562372371
        }
    )

)

