page 49 (
    name: Suivi des Dossiers
    alias: SUIVI-DES-DOSSIERS
    title: Suivi des Dossiers
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // On attend un court instant que le widget IG Single Row View soit rendu
            setTimeout(function() {
                $(".a-RV-body .a-Collapsible.is-expanded button").each(function() {
                    $(this).click();
                });
            }, 50);
            ```
    }
    css {
        inline:
            ```css
            /* 1) Donne une hauteur plus grande à la zone header (optionnel) */
            .myClass .a-GV-header{
              height: 60px;         /* Ajuste selon ton besoin */
              line-height: 50px;     /* Optionnel: vertical align/centrage */
              padding: 5px;
              white-space: normal;   /* Autorise le retour à la ligne */
              overflow-wrap: break-word;
              word-wrap: break-word;
            }
            
            /* 2) Force le texte du libellé à se wrapper */
            .myClass .a-GV-header .a-GV-headerLabel{
              white-space: normal;
              overflow-wrap: break-word;
              word-wrap: break-word;
              height: auto;
              line-height: 1.1;      /* Plus naturel pour du multi-ligne */
              padding: 5px;
            }
            
            
            
            
            /* 2 colonnes pour la Single Row View */
            .u-Form {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr  ;
                gap: 10px;
            }
            
            .a-RV .u-Form-inputContainer {
                align-items: baseline;
                background-color: #dddde6;
            }
            
            /* Style général */
            .a-IG-recordView {
                background-color: #f0f4ff;
            }
            
            .u-Form-label {
                font-size: 13px !important;
                font-weight: bold;
            
            }
            
            .apex-item-text,
            .apex-item-select,
            .apex-item-textarea {
                font-size: 13px !important;
                font-weight: bold;
                border-radius: 10px !important;
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region nouveau (
        name: Nouveau
        title: Dossiers  &P49_NEW_1.
        type: staticContent
        layout {
            sequence: 13
            slot: contentBody
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent2
                t-Region--noBorder
                js-headingLevel-1
                t-Region--hiddenOverflow
                t-Form--large
                t-Form--leftLabels
                t-Region-orderBy--center
            ]
            cssClasses: [
                zoom:
                150%;
            ]
        }
    )

    region suivi-des-dossiers (
        name: "suivi des Dossiers "
        title: suivi des Dossiers
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select SP.ID,
                       SP."عدد",
                       SP."طريقة_ابرام_الصفقة",
                       SP."نوعية_الطلب",
                       SP."اللجنة_المختصة",
                       SP."تاريخ_ورود_CPT_ممضاة",
                       SP."تاريخ_ارسال_مقترح_تركيبة_لجنة_التقييم",
                       SP."تاريخ_ورود_تعيين_تركيبة_لجنة_التقييم",
                       SP."تاريخ_تقديم_كراسات_الشروط_للمصادقة",
                       SP."تاريخ_مصادقة_اللجنة_على_كراسات_الشروط",
                       SP."تاريخ_ورود_محضر_مصادقة_اللجنة_على_كراسات_الشروط",
                       SP."تاريخ_ارجاع_كراسات_الشروط_حسب_المحضر",
                       SP."تاريخ_ورود_محضر_مصادقة_اللجنة_على_كراسات_الشروط2",
                       SP."التاريخ__للإعلان_عن_المنافسة",
                       SP."تاريخ_ارسال_التقرير_للتقييم_الفني",
                       SP."تاريخ_امضاء_تقرير_تقييم_العروض",
                       SP."تاريخ_تقديم_الملف_للجنة_الشراءات",
                       SP."تاريخ__لجنة_الصفقات",
                       SP."تاريخ_قرار__لجنة_الصفقات",
                       SP."تاريخ_نشر_نتائج_المنافسة",
                       SP.REF_AO,
                       SP.OBJET_CCT,
                       SP.BUDGET,
                       SP."DÉTAIL_DE_RÉPONSE",
                       SP.NATURE_DE_DEPENSE,
                       SP."DATE_LIMITE_PROPOSÉE",
                       SP.DATE_DE_LANC,
                       SP.DATE_OUVERTURE_DES_PLIS,
                       SP.STATUS,
                       SP."DATE_CRÉATION",
                          case when SP."اللجنة_المختصة" = 'CRA' then 40 else 4 end as P,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID_1' else 'P4_ID_1' end as VID1,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID_2' else 'P4_ID_2' end as VID2,
                    case when SP."اللجنة_المختصة" = 'CRA' then 'P40_ID' else 'P4_ID' end as VID,
                       CREER_PAR,
                        fl.ID as FL_ID,
                    fl.ID_CC 
                 from FICHIER_LNCEMENT fl,
                  CC_SP_STAT SP
                 where STATUS = :P49_NEW AND  fl.ID_CC =SP.ID
                ```
        }
        layout {
            sequence: 23
            slot: contentBody
            rowCssClasses: myClass
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkType: region
        }
        advanced {
            htmlDomId: mregion
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        editAuthorization {
            delete: @droits-d-administration
        }
        componentAppearance {
            selectFirstRow: false
            fixedRowHeight: false
        }
        pagination {
            type: page
            showTotalCount: false
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 66036329230227818
        }

