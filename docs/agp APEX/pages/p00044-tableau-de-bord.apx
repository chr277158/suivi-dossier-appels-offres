    region tous-les-contrats (
        name: Tous Les Contrats
        type: chart
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        settings {
