    dynamicAction nouveau (
        name: Nouveau_1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @contrats-en-cours
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @contrats-en-cours
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction nouveau-2 (
        name: Nouveau
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @appel-d-offres-en-cours
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @appel-d-offres-en-cours
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction nouveau-3 (
        name: Nouveau_1_1
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @tous-les-appel-d-offres
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tous-les-appel-d-offres
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction nouveau-4 (
        name: Nouveau_1_1_1
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @tous-les-contrats
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tous-les-contrats
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

