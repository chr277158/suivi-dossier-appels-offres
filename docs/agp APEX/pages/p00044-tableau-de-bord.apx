page 44 (
    name: "Tableau de bord "
    alias: TABLEAU-DE-BORD
    title: "Tableau de bord "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region appel-d-offres-en-cours (
        name: Appel d'Offres En Cours
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            show: false
        }
        autoRefresh {
            interval: 60
        }

        series série (
            name: Série 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                    STATUS,
                        CASE STATUS
                            WHEN '1' THEN 'En cours de Préparation'
                            WHEN '2' THEN 'Appel d''Offres en cour'
                            WHEN '3' THEN 'En cour d''Évaluation'
                            WHEN '4' THEN 'Traité en attente de classement'
                           -- when '5' then 'Infructueux'
                           -- when '6' then 'Fructueux'
                            --ELSE NVL(STATUS, 'Nouveau / Non traité')
                        END AS LABEL,
                        COUNT(*) AS VALEUR
                    FROM CC WHERE STATUS <5 
                    GROUP BY STATUS
                    ORDER BY STATUS
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALEUR
            }
            link {
                type: redirectThisApp
                target: {
                    page: 49
                    items: {
                        P49_NEW: &STATUS.
                        P49_NEW_1: &LABEL.
                    }
                }
            }
            label {
                show: true
                displayAs: labelValue
            }
            performance {
                maxRowsToProcess: 20
            }
        )

    )

    region chemin-de-navigation (
        name: Chemin de navigation
        type: breadcrumb
        source {
            breadcrumb: @chemin-de-navigation
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region contrats-en-cours (
        name: Contrats En Cours
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            show: false
        }
        autoRefresh {
            interval: 60
        }

        series série (
            name: Série 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                     /*   CASE ETAT
                            WHEN '1' THEN 'En cours de Préparation'
                            WHEN '2' THEN 'Appel d''Offres en cour'
                            WHEN '3' THEN 'En cour d''Évaluation'
                            WHEN '4' THEN 'Traité en attente de classement'
                            when '5' then 'Infructueux'
                            when '6' then 'Fructueux'
                            ELSE NVL(ETAT, 'Non défini')
                        END AS LABEL,
                     CASE
                          WHEN DATE_FIN_DU_MARCHÉ IS NOT NULL 
                             AND DATE_FIN_DU_MARCHÉ < SYSDATE
                        THEN 'Clôturé'   
                         WHEN DATE_DE_MISE_VIGUEUR <=  SYSDATE
                             AND (DATE_FIN_DU_MARCHÉ IS NULL 
                                  OR DATE_FIN_DU_MARCHÉ <= SYSDATE)
                                   THEN 'En exécution'
                        WHEN DATE_GARANTIE_FINALE IS NOT NULL THEN 'Cautionnement Définitif reçue'
                        WHEN DATE_RETOUR_ENREGISTRE IS NOT NULL THEN 'Contrat enregistré'
                        WHEN DATE_ENVOI_CLIENT_ENREGISTREMENT IS NOT NULL THEN 'Enregistrement en cours'
                        WHEN DATE_RETOUR_ADMIN_SIGNE IS NOT NULL THEN 'Signé par administration'
                        WHEN DATE_ENVOI_ADMIN_SIGNATURE IS NOT NULL THEN 'En attente signature administration'
                        WHEN DATE_RETOUR_CLIENT_SIGNE IS NOT NULL THEN 'Signé par titulaire'
                        WHEN DATE_ENVOI_CLIENT_SIGNATURE IS NOT NULL THEN 'En attente signature titulaire'
                        WHEN DATE_AVIS_JURIDIQUE IS NOT NULL THEN 'Avis juridique reçu'
                        WHEN DATE_LIVRAISON_JURIDIQUE IS NOT NULL THEN 'En cours avis juridique'
                    
                       
                        
                        ELSE 'Nouveau / Non traité'
                    END AS LABEL*/
                    
                    ETAT,
                    
                        COUNT(*) AS VALEUR
                    FROM CONTRATS  WHERE ETAT <> 'Clôturé' 
                    GROUP BY ETAT
                    ORDER BY ETAT
                    ```
            }
            columnMapping {
                label: ETAT
                value: VALEUR
            }
            link {
                type: redirectThisApp
                target: {
                    page: 46
                    items: {
                        P46_NEW: &ETAT.
                    }
                }
            }
            label {
                show: true
                displayAs: labelValue
            }
            performance {
                maxRowsToProcess: 20
            }
        )

    )

    region notes (
        name: Notes
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    cc.id,
                    cc.ref_ao,
                    cc.objet_cct,
                    cc.budget,
                    cc."DÉTAIL_DE_RÉPONSE",
                    cc.nature_de_depense,
                    cc."DATE_LIMITE_PROPOSÉE",
                    cc.date_de_lanc,
                    cc.pv_cct,
                    cc.programme_ouverture_de_plis,
                    cc.jours_rest,
                    cc.date_ouverture_des_plis,
                    cc.status,
                    case 
                    WHEN  sysdate - cc.date_ouverture_des_plis > = 30 THEN  'لقد مر  ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   يوما على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30 THEN 'لقد مر  ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   يوما على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود ( إن توفرت ) و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        WHEN sysdate - cc.date_ouverture_des_plis > 0 and  sysdate - cc.date_ouverture_des_plis < 20 THEN  'لقد مرت ' || FLOOR(sysdate - cc.date_ouverture_des_plis) || '   أيام على فتح العروض و لقد تمت معالجة الملف و إرجاع الضمانات الوقتية الرجاء إدخال المعطيات الخاصة بالعقود ( إن توفرت ) و ذلك بالضغط على الرابط أسفل هذا التنبيه   '
                        ELSE '🔴🔴🔴 🔴🔴🔴🔴وضع الملف غير عادي الرجاء التثبت'
                    
                   
                    end as stat,
                    CASE  
                        WHEN sysdate - cc.date_ouverture_des_plis > 30 THEN 'u-color-39'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30  THEN 'u-color-37'
                        WHEN sysdate - cc.date_ouverture_des_plis > 0 and  sysdate - cc.date_ouverture_des_plis < 20  THEN 'u-color-35'
                        ELSE 'u-color-44-contrast'
                    END AS COLOR_CELL,
                   CASE  
                        WHEN sysdate - cc.date_ouverture_des_plis > 30 THEN '🔴 عاجل جداً'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30  THEN '🟠 مهم'
                        WHEN sysdate - cc.date_ouverture_des_plis > 10 and  sysdate - cc.date_ouverture_des_plis < 20  THEN '🔵 عادي'
                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                    CASE
                        WHEN  sysdate - cc.date_ouverture_des_plis > 30 THEN 'fa-fire fa-1x fa-stop-circle fa-anim-horizontal-shake fa-lg'
                        WHEN  sysdate - cc.date_ouverture_des_plis > 20 and  sysdate - cc.date_ouverture_des_plis < 30 THEN 'fa-alarm-snooze fa-anim-spin-step fam-information fam-is-warning fa-lg'
                        WHEN sysdate - cc.date_ouverture_des_plis > 10 and  sysdate - cc.date_ouverture_des_plis < 20 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                       CASE
                        WHEN sysdate - cc.date_ouverture_des_plis > 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                    cc.creer_par,
                    cc."DATE_CRÉATION",
                    cc.programme_de_lancement
                FROM cc
                WHERE cc.status = 5
                
                  AND NOT EXISTS (
                        SELECT 1
                        FROM contrats ct
                        WHERE ct.id_cc = cc.id
                  )
                
                
                /*
                SELECT
                    ID,
                    NOTE_TITLE   AS NOTETITLE,
                    NOTE_DETAILS AS NOTEDETAILS,
                    REMINDER_DATETIME,
                    TO_CHAR(REMINDER_DATETIME, 'DD Mon - HH24:MI') AS REMINDERFMT,
                
                    -- أيقونة ولون حسب الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'fa-bell text-danger'
                        WHEN 2 THEN 'fa-exclamation-triangle text-warning'
                        WHEN 1 THEN 'fa-sticky-note text-info'
                        ELSE 'fa-circle text-muted'
                    END AS CARDICON,
                
                    -- نص الأهمية
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN '🔴 عاجل جداً'
                        WHEN 2 THEN '🟠 مهم'
                        WHEN 1 THEN '🔵 عادي'
                        ELSE '⚪ عادي'
                    END AS IMPORTANCETEXT,
                
                    -- نص الشريط: الدقائق + النسبة المئوية
                    CASE
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE
                             AND REMINDER_DATETIME >= SYSDATE - 0.1/24 THEN
                             '🔄 تذكير مستمر (' || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             ) || '%)'
                        WHEN REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) <= SYSDATE THEN
                             '✅ انتهى (100%)'
                        ELSE
                             FLOOR(((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440)
                             || ' Minutes ('
                             || ROUND(
                                 LEAST(100, GREATEST(0,
                                   (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                                         ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                                 ))
                             )
                             || '%) '
                    END AS MINUTES_LEFT,
                
                    -- نسبة التقدم (0-100) متاحة لو احتجتها لاحقاً
                    LEAST(100, GREATEST(0,
                        (1 - (((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) /
                              ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - TRUNC(SYSDATE)))) * 100
                    )) AS PROGRESS_PERCENT,
                
                    -- كلاس إضافي لو أردت تأثير خاص عند الاقتراب (اختياري)
                    CASE
                        WHEN ((REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440)) - SYSDATE) * 1440 <= 30
                            THEN 'near'
                        ELSE ''
                    END AS BADGE_CLASS,
                
                    -- لون شريط التقدم حسب الأهمية (لو استخدمته داخل CSS)
                    CASE IMPORTANCE_LEVEL
                        WHEN 3 THEN 'bg-danger'
                        WHEN 2 THEN 'bg-warning'
                        WHEN 1 THEN 'bg-info'
                        ELSE 'bg-secondary'
                    END AS PROGRESS_COLOR
                
                FROM USER_NOTES
                WHERE USER_ID = :P32_ROLE
                   AND NOT (IS_SENT = 'Y'
                           AND REMINDER_DATETIME - (NVL(PRE_REMINDER_MINS,0)/1440) < SYSDATE -1)
                ORDER BY IMPORTANCE_LEVEL DESC, REMINDER_DATETIME ASC;
                */
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--featured t-HeroRegion--centered
                t-HeroRegion--hideIcon
            ]
        }
        advanced {
            customAttributes: Refresh Interval: 600
        }
        componentAppearance {
            gridColumns: 4
        }
        title {
            column: REF_AO
        }
        subtitle {
            column: STAT
            cssClasses: &COLOR_CELL.
        }
        body {
            column: OBJET_CCT
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: CARDICON
            iconCssClasses: &COLOR_CELL.
            iconPosition: top
            badgeColumn: IMPORTANCETEXT
        }

        action action (
            label: تغيير الملفات التي في حالة الإنتظار
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 39
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-reply-all
                hot: true
            }
        )

    )

    region tous-les-appel-d-offres (
        name: Tous Les Appel d'Offres
        type: chart
        layout {
            sequence: 40
