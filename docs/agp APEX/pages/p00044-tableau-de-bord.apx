                    SELECT 
                    STATUS,
                        CASE STATUS
                            WHEN '1' THEN 'En cours de Préparation'
                            WHEN '2' THEN 'Appel d''Offres en cour'
                            WHEN '3' THEN 'En cour d''Évaluation'
                            WHEN '4' THEN 'Traité en attente de classement'
                            when '5' then 'Fructueux'
