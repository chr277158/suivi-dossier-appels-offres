    pageItem P16_STATUS (
        type: radioGroup
        label {
            label: Status
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:En cours;1,Approuvé;2,Infructueuse;3
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @dates
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
