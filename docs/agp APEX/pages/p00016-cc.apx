page 16 (
    name: Cc
    alias: CC
    title: Cc
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#jquery.maskedinput.min.js
        executeWhenPageLoads:
            ```javascript-browser
            $("#P4_REF_AO").mask("AE.##.#.####");
            //$("#P4_BUDGET").mask("## ###.###,###")
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boutons (
        name: Boutons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region cc (
        name: Cc
        type: form
        source {
            location: localDatabase
            tableName: CC
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region dates (
        name: Dates
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @cc
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region fichiers-de-lancement (
        name: Fichiers de lancement
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @cc
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region info-principales (
        name: "Info Principales "
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @cc
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            expandShortcuts: true
        }
    )

    region new (
        name: New
        type: classicReport
        source {
            location: localDatabase
            tableName: SP
            whereClause: عدد= v(:P16_REF_AO)
        }
        layout {
            sequence: 50
            parentRegion: @cc
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column EXP__INV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Exp Inv
            }
            layout {
                sequence: 40
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column التاريخ__للإعلان_عن_المنافسة (
